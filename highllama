#!/usr/bin/env bash
#
# highllama — launch ANY GGUF model on llama.cpp server (NVIDIA / AMD / Apple)
#
# Backends (autodetected, override with --backend or BACKEND=):
#   cuda    NVIDIA (nvidia-smi present)
#   rocm    AMD via HIP/ROCm (rocm-smi / amd-smi present)
#   vulkan  AMD/Intel/anything with a Vulkan driver
#   metal   macOS / Apple silicon (default on Darwin; unified memory)
#   mlx     macOS MLX runtime (mlx_lm.server, not llama.cpp; -m = HF repo)
#   cpu     no GPU found
#
# One-shot setup on any platform:
#   highllama deps [backend]    # install build requirements (pacman/apt/dnf/zypper/brew)
#   highllama build [backend]   # clone (if needed) + cmake-build llama.cpp for the backend
#   highllama update [backend]  # git pull llama.cpp + rebuild for the backend
#
# Manual cmake equivalents (inside llama.cpp/):
#   NVIDIA: cmake -B build -DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=89
#   AMD:    cmake -B build -DGGML_HIP=ON -DAMDGPU_TARGETS=gfx1100   # your gfx
#       or: cmake -B build -DGGML_VULKAN=ON                         # easier
#   macOS:  cmake -B build                                          # Metal default
#   MLX:    pip install mlx-lm                                      # no build
#
# Usage (run `highllama help` for the full reference; bare `highllama` shows it):
#   highllama pull                              # browse/search HF, pick + download
#   highllama pull qwen3 coder                  # search HF by term
#   highllama pull unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q5_K_XL  # direct
#   highllama start                             # interactive picker, 64k ctx
#   highllama ls                                # list local models (picker view)
#   highllama start -m unsloth/gpt-oss-20b-GGUF:Q8_0  # any HF repo:quant
#   highllama start -m /path/to/model.gguf -c 32k     # any local GGUF
#   highllama start -m <model> -c 128k --ncmoe 44     # 128k + manual offload
#   highllama start -m <model> -c 128k --ncmoe 73%    # offload as a share of the layers
#   highllama start -m ornith-1.5                       # model presets fill ncmoe/extras (see PRESETS)
#   highllama start --backend mlx -m mlx-community/Qwen3-8B-4bit
#   highllama start -m <model> --draft unsloth/Qwen3-0.6B-GGUF:Q8_0   # spec-decoding
#   highllama start -m unsloth/gemma-4-12B-it-GGUF:Q4_K_XL --mtp      # multi-token prediction
#   highllama start -m <model> --chat-template ./my.jinja            # override broken GGUF template
#   highllama start -m <model> --daemon          # background; logs -> journal
#   highllama logs                              # stream daemon journal logs
#   highllama reload -c 128k --mtp              # stop running server and restart with new flags
#   highllama restart                           # stop + start with the same settings as last start
#   highllama start --no-embeddings              # remove the embeddings from the server
#                                                # model (CLS pooling, /v1/embeddings)
#
# Everything is overridable by flag OR env var (flag wins):
#   MODEL CONTEXT NCMOE THREADS KVTYPE KVTYPE_K KVTYPE_V FA DRY DRAFT MTP MTP_NMAX TEMPLATE EMBED_MODEL HOST PORT BACKEND
#
# MTP + embeddings together: when --mtp/--draft is set AND embeddings are on,
# highllama serves both via llama.cpp router mode (chat model + a small embedding
# model as separate child processes behind one endpoint). The embedding model is
# auto-discovered or set with EMBED_MODEL=; --no-embeddings opts out.
#
set -euo pipefail

# resolve the real script location (works when invoked via a ~/.local/bin symlink)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    link="$(readlink "$SCRIPT_PATH")"
    case "$link" in /*) SCRIPT_PATH="$link" ;; *) SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$link" ;; esac
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

# ---- defaults -------------------------------------------------------------
LLAMA_DIR="${LLAMA_DIR:-$SCRIPT_DIR/llama.cpp}"
MODEL="${MODEL:-}"        # empty => interactive picker (no-arg dynamic mode)
CONTEXT="${CONTEXT:-64k}" # accepts 32k / 64k / 128k or a raw token count
NCMOE="${NCMOE:-}"        # MoE layers pinned to CPU: a count, or "N%" of the layers;
                          # empty = auto by free VRAM (or a model preset, see below)
THREADS="${THREADS:-}"    # empty = physical cores. NEVER SMT count (gen collapses)
KVTYPE="${KVTYPE:-}"      # KV cache quant shorthand: when set, overrides both sides (q4_0|q8_0|f16)
KVTYPE_K="${KVTYPE_K:-}"  # K-cache quant; empty => q8_0, or KVTYPE if given. set via --kv-k
KVTYPE_V="${KVTYPE_V:-}"  # V-cache quant; empty => q8_0 (symmetric: FA kernels need k==v). --kv-v
FA="${FA:-auto}"          # flash-attn: auto|on|off. auto keeps FA on; KV defaults to symmetric
                          # q8_0 (mismatched k/v falls back to CPU). off = non-FA path (needs f16).
DRY="${DRY:-0}"           # DRY sampler multiplier (0 = off, the default). NOT safe for agentic
                          # use: long verbatim literals (file paths, UUIDs) have no sequence
                          # breakers, so DRY forces typos when the model retypes them. --dry <n>
PARALLEL="${PARALLEL:-1}" # server slots. 1 = single-user (least VRAM). >1 multiplies buffers
DRAFT="${DRAFT:-}"        # optional draft model (HF tag or path) for speculative decoding
MTP="${MTP:-auto}"        # multi-token prediction: auto|on|off. auto enables it when a
                          # local model ships an MTP head (mtp- sibling or embedded nextn)
MTP_NMAX="${MTP_NMAX:-2}" # MTP tokens drafted per step (unsloth recommends 2; try 1-6)
TEMPLATE="${TEMPLATE:-}"  # --chat-template: override the GGUF's Jinja chat template (file path)
HOST="${HOST:-0.0.0.0}"   # 0.0.0.0 = reachable from other machines on the LAN
PORT="${PORT:-8089}"      # 8080 is a very common conflict; auto-advances if busy
BACKEND="${BACKEND:-}"    # empty = autodetect (see detect_backend)
DAEMON=""                 # --daemon: detach to background, logs -> journal
EXTRA=()                  # any extra args after `--` are passed straight to llama-server
ALLMODELS=1
ALLMODELS_EXTRA=()
MODELS_DIR="${MODELS_DIR:-$HOME/.lmstudio/models}" # router-mode model root (one-level subdirs)
MODELS_MAX="${MODELS_MAX:-2}"                      # router-mode: max models loaded c
EMBED_MODEL="${EMBED_MODEL:-}"                     # embedding model (path/substring) for MTP+embeddings router; auto-discovered if empty
HL_STATE="${HL_STATE:-${XDG_CONFIG_HOME:-$HOME/.config}/highllama/speed.tsv}" # measured-speed state (probe baselines + tuned configs)
PROBE="${PROBE:-1}"       # startup decode-speed probe: 1 = on (--no-probe / PROBE=0 to skip)
PROBE_REGRESS_PCT="${PROBE_REGRESS_PCT:-70}" # warn when measured decode falls below this % of best-known
HL_PRESETS="${HL_PRESETS:-${XDG_CONFIG_HOME:-$HOME/.config}/highllama/presets}" # user model presets (see MODEL_PRESETS)

# ---- model presets ---------------------------------------------------------
# Per-model-family launch defaults, applied by `start` (so `reload`/`restart`
# inherit them) only where nothing else decided: explicit flags/env win, and so
# does a measured `highllama tune` record. One preset per line:
#   <glob>[|<glob>...]<space/tab>KEY=VAL [KEY=VAL ...]
# Globs are case-insensitive and match "<publisher>/<repo>/<file-stem>" of a
# local model (e.g. ornith-ai/Ornith-1.5-35B-A3B-GGUF/Ornith-1.5-35B-Q4_K_M) or
# the HF tag of a -hf launch. Keys: NCMOE (count or N% of the layers), KVTYPE,
# MTP (on|off), EXTRA="<llama-server flags>" (a flag already given after -- is
# skipped). $HL_PRESETS lines are checked before these built-ins; first match wins.
MODEL_PRESETS=(
    # Qwen3.5-MoE 35B-A3B family — Qwen3.6-35B-A3B, Qwen-AgentWorld-35B-A3B,
    # Ornith-1.x-35B-A3B (same architecture): 41 layers, ~21GB at Q4. On a 12GB
    # card, 73% of the experts on CPU (30/41) is what kept 128k ctx resident and
    # fast for the local Qwen agent (`--ncmoe 30 -- -ub 2048 -b 2048`); the 2k
    # batches were part of that measured setup, so they travel with it.
    '*35B-A3B*|*Ornith-*-35B*	NCMOE=73% EXTRA="-ub 2048 -b 2048"'
)

# Where local GGUFs live: LM Studio models + llama.cpp/HF download caches
# + Unsloth Studio (legacy HF cache, fine-tune exports/outputs; its main
# downloads go to the standard HF hub cache above)
MODEL_ROOTS=("$HOME/.lmstudio/models" "$HOME/.cache/huggingface/hub"
    "$HOME/.cache/llama.cpp" "$HOME/Library/Caches/llama.cpp"
    "$HOME/.unsloth/studio/cache/huggingface/hub"
    "$HOME/.unsloth/studio/exports" "$HOME/.unsloth/studio/outputs")

# ---- portability helpers (GNU/Linux + BSD/macOS) ---------------------------
OS="$(uname -s)"

file_size() { # bytes, following symlinks
    stat -Lc%s "$1" 2>/dev/null || stat -Lf%z "$1" 2>/dev/null
}

port_busy() {
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | command grep -q ":$1 "
    elif command -v lsof >/dev/null 2>&1; then
        lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
    else
        netstat -an 2>/dev/null | command grep -q "[.:]$1 .*LISTEN"
    fi
}

physical_cores() {
    if [ "$OS" = "Darwin" ]; then
        sysctl -n hw.physicalcpu 2>/dev/null || echo 8
    else
        local n
        n="$(lscpu -b -p=Core,Socket 2>/dev/null | command grep -v '^#' | sort -u | wc -l)"
        [ "${n:-0}" -gt 0 ] && echo "$n" || echo "$(($(nproc 2>/dev/null || echo 16) / 2))"
    fi
}

detect_backend() {
    if [ "$OS" = "Darwin" ]; then
        echo metal
        return
    fi
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1; then
        echo cuda
        return
    fi
    if command -v rocm-smi >/dev/null 2>&1 || command -v amd-smi >/dev/null 2>&1; then
        echo rocm
        return
    fi
    if command -v vulkaninfo >/dev/null 2>&1; then
        echo vulkan
        return
    fi
    echo cpu
}

# free VRAM in MiB; prints nothing if unknown (caller falls back to buckets)
free_vram_mib() {
    case "$1" in
    cuda)
        nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null |
            head -1 | tr -dc '0-9'
        ;;
    rocm)
        # rocm-smi CSV: device,VRAM Total Memory (B),VRAM Total Used Memory (B)
        rocm-smi --showmeminfo vram --csv 2>/dev/null | awk -F, '
        NR==2 { printf "%d\n", ($2-$3)/1048576 }'
        ;;
    *) : ;; # vulkan/metal/cpu: unknown / unified memory
    esac
}

gpu_status() {
    case "$1" in
    cuda) nvidia-smi --query-gpu=memory.used,memory.free,memory.total --format=csv,noheader 2>/dev/null || true ;;
    rocm) rocm-smi --showmeminfo vram 2>/dev/null | command grep -i vram || true ;;
    metal) echo "unified memory: $(($(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1048576)) MiB total" ;;
    *) echo "(no VRAM telemetry for backend '$1')" ;;
    esac
}

# Is this .gguf an MTP draft head rather than a servable model? Heads carry an
# 'mtp' marker in the basename -- either as a prefix (mtp-gemma-4-12B-it.gguf) or
# as a segment (gemma-4-12B-it-MTP-Q8_0.gguf) -- and always ship next to the
# larger main model they draft for. The bigger-sibling check is what makes this
# safe: a real model whose name merely mentions MTP (releases that bundle an
# embedded nextn head) is the largest .gguf in its own directory, so it stays.
is_mtp_head() {
    local f="$1" b sz other
    b="$(basename "$f" | tr 'A-Z' 'a-z')"
    case "$b" in
    mtp-* | *[-_.]mtp[-_.]*) ;;
    *) return 1 ;;
    esac
    sz="$(file_size "$f")" || return 1
    for other in "$(dirname "$f")"/*.gguf; do
        [ -f "$other" ] || continue
        [ "$(file_size "$other")" -gt "$sz" ] && return 0
    done
    return 1
}

# drop MTP draft heads from a newline-separated list of .gguf paths on stdin
filter_mtp_heads() {
    local f
    while IFS= read -r f; do is_mtp_head "$f" || printf '%s\n' "$f"; done
}

# every local .gguf that can actually be served: no multimodal projectors, no MTP
# draft heads, no raw HF blobs (the symlinked snapshot path is the readable one)
find_servable_ggufs() {
    local d
    for d in "${MODEL_ROOTS[@]}"; do
        [ -d "$d" ] || continue
        command find -L "$d" -type f -iname '*.gguf' 2>/dev/null # -L: follow HF-cache symlinks
    done | command grep -iv 'mmproj' | command grep -v '/blobs/' | filter_mtp_heads
}

# list every servable local .gguf with size + path
list_local_models() {
    printf '%-10s  %s\n' "SIZE" "PATH"
    find_servable_ggufs | sort -u | while read -r f; do
        printf '%-10s  %s\n' "$(command du -hL "$f" 2>/dev/null | cut -f1)" "$f"
    done
}

# resolve a search term to the best local .gguf (largest servable match); empty if none
resolve_local_gguf() {
    local term="$1"
    find_servable_ggufs | command grep -i -- "$term" |
        while read -r f; do printf '%s\t%s\n' "$(file_size "$f")" "$f"; done |
        sort -rn | head -1 | cut -f2- || true
}

# ---- multimodal projector (mmproj) auto-discovery ---------------------------
# Vision-capable GGUFs need a separate mmproj projector to accept images; llama.cpp
# only loads it when passed --mmproj. Normalize a model/projector basename to a
# family key by dropping the quant/format tail, so e.g.
#   gemma-4-12b-it-qat-ud-q4_k_xl      -> gemma-4-12b-it-qat
#   mmproj-gemma-4-12b-it-qat-bf16     -> gemma-4-12b-it-qat
# collapse to the same key and can be matched across quants and repos.
mmproj_stem() {
    basename "$1" | tr 'A-Z' 'a-z' |
        command sed -E 's/\.gguf$//; s/^mmproj-//; s/-(ud-)?(i?q[0-9][0-9a-z_]*|bf16|f16|f32|mxfp[0-9]+).*$//'
}

# Best mmproj for a resolved model path, or empty: a sibling mmproj in the model's
# own directory wins (definitely correct); otherwise the first family-stem match
# found across the known model roots (handles projectors that ship in a different
# repo folder than the text weights). Empty when the model has no vision projector.
resolve_mmproj_for() {
    local model="$1" dir stem d m
    dir="$(dirname "$model")"
    for m in "$dir"/mmproj-*.gguf "$dir"/*mmproj*.gguf; do
        [ -f "$m" ] && { printf '%s\n' "$m"; return 0; }
    done
    stem="$(mmproj_stem "$model")"
    [ -n "$stem" ] || return 0
    for d in "${MODEL_ROOTS[@]}"; do
        [ -d "$d" ] || continue
        command find -L "$d" -type f -iname 'mmproj-*.gguf' 2>/dev/null
    done | sort -u | while read -r m; do
        [ "$(mmproj_stem "$m")" = "$stem" ] && { printf '%s\n' "$m"; break; }
    done
    # "no projector for this model" is the normal text-only case, not an error:
    # the while loop above ends on a failed stem comparison, and without this
    # the nonzero status propagates into MMPROJ_HIT=$(...) and set -e kills the
    # launch with no message. Callers detect "none" by the empty output.
    return 0
}

# resolve an embedding model for router mode: $EMBED_MODEL (exact path or local
# substring match) if set, else auto-discover the smallest local embedding GGUF
# (embeddinggemma / bge / nomic / gte / e5 / minilm / arctic-embed). Empty if none.
resolve_embed_model() {
    if [ -n "${EMBED_MODEL:-}" ]; then
        if [ -f "$EMBED_MODEL" ]; then printf '%s\n' "$EMBED_MODEL"; else resolve_local_gguf "$EMBED_MODEL"; fi
        return
    fi
    find_servable_ggufs |
        command grep -iE 'embed|bge|nomic|gte-|e5-|minilm|arctic-embed' |
        while read -r f; do printf '%s\t%s\n' "$(file_size "$f")" "$f"; done |
        sort -n | head -1 | cut -f2- || true # smallest first: embedding models are small
}

# all local model paths, one per line (for the interactive picker)
collect_local_models() {
    find_servable_ggufs | sort -u || true
}

# Human-readable repo label for a model path: the org/repo folder it lives in,
# relative to whichever model root holds it. Quants of the same family often share
# an uninformative basename (gemma4-v2-Q4_K_M.gguf), so this is what tells them
# apart in the picker.
#   .lmstudio/models/yuxinlu1/gemma-4-…-GGUF/x.gguf        -> yuxinlu1/gemma-4-…-GGUF
#   .cache/huggingface/hub/models--unsloth--foo/snapshots/ab12/x.gguf -> unsloth/foo
model_repo_label() {
    local dir rel="" d
    dir="$(dirname "$1")"
    for d in "${MODEL_ROOTS[@]}"; do
        # sitting directly in a root (flat llama.cpp cache): no repo folder to name
        [ "$dir" = "$d" ] && break
        case "$dir/" in
        "$d"/*)
            rel="${dir#"$d"/}"
            break
            ;;
        esac
    done
    [ -n "$rel" ] || rel="$(basename "$dir")"
    case "$rel" in # HF cache: models--org--repo/snapshots/<sha> -> org/repo
    models--*)
        rel="${rel%%/snapshots/*}"
        rel="${rel#models--}"
        rel="${rel//--//}"
        ;;
    esac
    printf '%s\n' "$rel"
}

# numbered size+name listing of local models (picker look); fills MODELS array.
# Grouped under the owning repo, because the basename alone frequently doesn't
# identify the model (which gemma-4-12B is this — the QAT, the unsloth UD quant,
# or the yuxinlu1 fine-tune?). collect_local_models sorts by full path, so
# entries from the same repo already arrive adjacent. Returns 1 if none found.
print_model_menu() {
    MODELS=()
    local m idx=1 repo last_repo=""
    while IFS= read -r m; do [ -n "$m" ] && MODELS+=("$m"); done < <(collect_local_models)
    [ "${#MODELS[@]}" -gt 0 ] || return 1
    for m in "${MODELS[@]}"; do
        repo="$(model_repo_label "$m")"
        [ "$repo" = "$last_repo" ] || printf "  %s/\n" "$repo"
        last_repo="$repo"
        printf "  %2d) %-7s %s\n" "$idx" "$(command du -hL "$m" 2>/dev/null | cut -f1)" "$(basename "$m")"
        idx=$((idx + 1))
    done
}

# normalize a context size: accepts 32k / 64K / 128k / 131072 -> token count
to_tokens() {
    local v="$1"
    case "$v" in
    *[kK]) echo $((${v%[kK]} * 1024)) ;;
    *[mM]) echo $((${v%[mM]} * 1024 * 1024)) ;;
    *) echo "$v" ;;
    esac
}

# is a server already running? prints its cmdline if so.
# Detect by exact process NAME so it matches whatever `stop` (pkill -x) kills,
# regardless of how/where the server was launched (avoids stacking a 2nd server
# on top of one already holding VRAM). Also catches an MLX server.
server_running() {
    local pid
    pid="$(pgrep -x llama-server 2>/dev/null | head -1 || true)"
    [ -n "$pid" ] || pid="$(pgrep -f 'mlx_lm.server|mlx_lm server' 2>/dev/null | head -1 || true)"
    [ -n "$pid" ] || return 0
    ps -o args= -p "$pid" 2>/dev/null || true
}

# ---- speed state + probe helpers (F: guaranteed-fastest startup) ------------
# Measured decode speeds live in $HL_STATE (TSV, human-editable). Two kinds:
#   best  — fastest decode ever measured for (alias, gpu, ctx bucket); the
#           startup probe warns when a launch falls below PROBE_REGRESS_PCT of it
#   tune  — config winner persisted by `highllama tune`; `start` applies it
#           unless the user passed an explicit flag for the same knob

# KV bits-per-element for the chosen cache type (used to size the KV reserve).
# K and V each hold half the cache, so average their per-side bits.
kv_bits() {
    case "$1" in
    q4_0 | q4_1 | iq4_nl) echo 4.5 ;;
    q5_0 | q5_1) echo 5.5 ;;
    q8_0) echo 8.5 ;;
    f16 | bf16) echo 16 ;;
    *) echo 16 ;;
    esac
}

# Does a GGUF carry an *embedded* MTP/nextn head? Models like unsloth Qwen3.6
# advertise a `.nextn_predict_layers` key; most (incl. gemma-4 chat GGUFs,
# whose MTP head ships as a separate 'mtp-*.gguf' sibling) do not. Requesting
# draft-mtp against a model with no embedded head makes llama.cpp abort at
# load ("context type MTP requested but model doesn't contain MTP layers").
# Prints "1" only when an embedded head is present. Defaults to the resolved
# -m model; `tune` passes an explicit path.
model_has_embedded_mtp() { # [gguf-path]
    local f="${1:-}"
    if [ -z "$f" ]; then
        [ "${MODEL_ARGS[0]:-}" = "-m" ] || return 0
        f="${MODEL_ARGS[1]}"
    fi
    command -v python3 >/dev/null 2>&1 || return 0
    python3 - "$f" <<'PY' 2>/dev/null
import sys,struct
try:
    f=open(sys.argv[1],'rb'); f.read(4); struct.unpack('<I',f.read(4)); struct.unpack('<Q',f.read(8))
    n_kv=struct.unpack('<Q',f.read(8))[0]
    def rs():
        n=struct.unpack('<Q',f.read(8))[0]; return f.read(n).decode('utf-8','replace')
    def rv(t):
        if t==8: return rs()
        if t==9:
            et=struct.unpack('<I',f.read(4))[0]; ln=struct.unpack('<Q',f.read(8))[0]; return [rv(et) for _ in range(ln)]
        fm={0:'B',1:'b',2:'H',3:'h',4:'I',5:'i',6:'f',7:'?',10:'Q',11:'q',12:'d'}[t]
        return struct.unpack('<'+fm,f.read(struct.calcsize(fm)))[0]
    for _ in range(n_kv):
        k=rs(); t=struct.unpack('<I',f.read(4))[0]; v=rv(t)
        if 'nextn' in k or k.endswith('.nextn_predict_layers'):
            print(1); break
        if k.startswith('tokenizer.'): break
except Exception:
    pass
PY
}

gpu_name() { # stable hardware key for the state file (underscored, no tabs)
    local n=""
    case "$BACKEND" in
    cuda) n="$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)" ;;
    rocm) n="$(rocm-smi --showproductname --csv 2>/dev/null | tail -1 | cut -d, -f2)" ;;
    metal | mlx) n="$(sysctl -n machdep.cpu.brand_string 2>/dev/null)" ;;
    esac
    [ -n "$n" ] || n="$BACKEND"
    printf '%s\n' "$n" | tr ' ,\t' '___'
}

ctx_bucket() { # token count -> canonical band, so 60k and 64k share one record
    local c="$1" b
    for b in 16384 32768 65536 131072 262144; do
        [ "$c" -le "$b" ] && { echo "$b"; return; }
    done
    echo "$c"
}

preset_lookup() { # <label> -> KEY=VAL tail of the first matching preset line, or nothing
    local label="$1" line pats rest pat
    {
        [ -f "$HL_PRESETS" ] && cat "$HL_PRESETS"
        printf '%s\n' "${MODEL_PRESETS[@]}"
    } | while IFS= read -r line; do
        case "$line" in '' | '#'*) continue ;; esac
        pats="${line%%[[:space:]]*}"
        rest="${line#"$pats"}"
        rest="${rest#"${rest%%[![:space:]]*}"}"
        local IFS='|'
        for pat in $pats; do
            # shellcheck disable=SC2254 # the preset IS a glob
            case "${label,,}" in ${pat,,}) printf '%s\n' "$rest"; exit 0 ;; esac
        done
    done
    return 0
}

resolve_ncmoe_pct() { # <count|N%> <layers> -> integer layer count (N% of <layers>, clamped)
    local v="$1" cap="$2"
    case "$v" in
    *%) awk -v p="${v%\%}" -v c="$cap" 'BEGIN{n=int(p*c/100+0.5); if(n<0)n=0; if(n>c)n=c; print n}' ;;
    *) printf '%s\n' "$v" ;;
    esac
}

state_get() { # <kind> <alias> <gpu> <bucket> -> "config<TAB>tps<TAB>date" or nothing
    [ -f "$HL_STATE" ] || return 0
    awk -F'\t' -v k="$1" -v a="$2" -v g="$3" -v b="$4" \
        '$1==k && $2==a && $3==g && $4==b {print $5 "\t" $6 "\t" $7; exit}' "$HL_STATE"
}

state_put() { # <kind> <alias> <gpu> <bucket> <config> <tps> — replaces the key's line
    local dir tmp
    dir="$(dirname "$HL_STATE")"
    mkdir -p "$dir"
    [ -f "$HL_STATE" ] || printf '# highllama speed state v1\n# kind\talias\tgpu\tctx_bucket\tconfig\ttps\tdate\n' >"$HL_STATE"
    tmp="$(mktemp "$dir/.speed.XXXXXX")"
    awk -F'\t' -v k="$1" -v a="$2" -v g="$3" -v b="$4" \
        '!($1==k && $2==a && $3==g && $4==b)' "$HL_STATE" >"$tmp"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6" "$(date +%Y-%m-%d)" >>"$tmp"
    mv "$tmp" "$HL_STATE"
}

state_del() { # <kind> <alias> <gpu> <bucket>
    [ -f "$HL_STATE" ] || return 0
    local tmp
    tmp="$(mktemp "$(dirname "$HL_STATE")/.speed.XXXXXX")"
    awk -F'\t' -v k="$1" -v a="$2" -v g="$3" -v b="$4" \
        '!($1==k && $2==a && $3==g && $4==b)' "$HL_STATE" >"$tmp"
    mv "$tmp" "$HL_STATE"
}

wait_api_ready() { # <port> [timeout_s] — /health 200s only once the model is loaded
    local port="$1" t="${2:-300}" _
    for _ in $(seq 1 $((t * 2))); do
        curl -fsS --max-time 3 "http://127.0.0.1:$port/health" >/dev/null 2>&1 && return 0
        sleep 0.5
    done
    return 1
}

probe_decode_tps() { # <port> <alias> [n_predict] -> decode t/s, or nothing if unusable
    # prose prompt on purpose: trivially-predictable output (number sequences)
    # inflates speculative-decoding acceptance and reports a t/s no real
    # workload sees
    local port="$1" alias="$2" n="${3:-64}" resp
    resp="$(curl -sS --max-time 180 "http://127.0.0.1:$port/v1/chat/completions" \
        -H 'Content-Type: application/json' \
        -d '{"model":"'"$alias"'","messages":[{"role":"user","content":"Explain how a bicycle drivetrain transfers power from the pedals to the rear wheel."}],"temperature":0,"top_k":1,"max_tokens":'"$n"',"stream":false}' \
        2>/dev/null)" || return 0
    [ -n "$resp" ] || return 0
    printf '%s' "$resp" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    t = d.get("timings") or {}
    n = t.get("predicted_n") or (d.get("usage") or {}).get("completion_tokens") or 0
    tps = t.get("predicted_per_second") or 0
    if n < 2:
        raise SystemExit
    if not tps or tps > 5000:  # llama.cpp emits a bogus 1e6 rate on some paths
        ms = t.get("predicted_ms") or 0
        if not ms:
            raise SystemExit
        tps = n / ms * 1000.0
    if not (0 < tps < 5000):
        raise SystemExit
    # degenerate-output check: a repetition loop generates FAST, so speed alone
    # would record garbage as a best. Low distinct-4-gram ratio = looping.
    flag = ""
    try:
        words = ((d.get("choices") or [{}])[0].get("message") or {}).get("content", "").split()
        if len(words) >= 24:
            grams = [tuple(words[i:i+4]) for i in range(len(words) - 3)]
            if len(set(grams)) / len(grams) < 0.4:
                flag = " loop"
    except Exception:
        pass
    print(f"{tps:.1f}{flag}")
except Exception:
    pass
' 2>/dev/null
}

max_full_fit_ctx() { # <model> <free_mib> <parallel> <kv_bits> <req_ctx> -> largest ctx that fully fits, or nothing
    local m="$1" free="$2" par="$3" kvb="$4" hi="$5" lo=4096 mid out
    out="$(python3 "$SCRIPT_DIR/gguf-estimate.py" "$m" "$free" "$lo" "$par" "$kvb" 2>/dev/null || true)"
    case "$out" in "moe 0 "*) ;; *) return 0 ;; esac # doesn't fit even at 4k
    while [ $((hi - lo)) -gt 2048 ]; do
        mid=$(((lo + hi) / 2 / 1024 * 1024))
        [ "$mid" -le "$lo" ] && break
        out="$(python3 "$SCRIPT_DIR/gguf-estimate.py" "$m" "$free" "$mid" "$par" "$kvb" 2>/dev/null || true)"
        case "$out" in "moe 0 "*) lo="$mid" ;; *) hi="$mid" ;; esac
    done
    echo "$lo"
}

warn_partial_offload() { # $1 = full-fit ctx tip ("" = nothing fits); uses MODE NCMOE NCMOE_CAP CONTEXT
    local tip="$1" pct
    {
        echo "!! ------------------------------------------------------------------"
        if [ "$MODE" = "dense" ]; then
            # decode is memory-bound: speed tracks the GPU-resident weight
            # fraction, roughly squared (measured 4070: 38/48->60%, 23/48->22%)
            pct="$(awk -v n="$NCMOE" -v c="$NCMOE_CAP" 'BEGIN{f=n/(c+1); printf "%d", f*f*100}')"
            echo "!! DEGRADED OFFLOAD: $NCMOE of $NCMOE_CAP layers on GPU (ctx=$CONTEXT)"
            echo "!! rough decode estimate: ~${pct}% of full-offload speed"
            if [ -n "$tip" ]; then
                echo "!! tip: -c $tip keeps the whole model on GPU at full speed"
            else
                echo "!! even at 4k ctx the model does not fit — use a smaller quant or model"
            fi
        else
            # MoE: CPU-side experts are sparsely activated, so the dense speed
            # model doesn't apply — expert offload is the normal way to run a
            # big MoE, just note the knob instead of crying wolf
            echo "!! PARTIAL OFFLOAD: $NCMOE of $NCMOE_CAP MoE expert layers on CPU (ctx=$CONTEXT)"
            if [ -n "$tip" ]; then
                echo "!! tip: -c $tip keeps all experts on GPU at full speed"
            else
                echo "!! a smaller -c frees VRAM for more experts on GPU (faster decode)"
            fi
        fi
        echo "!! ------------------------------------------------------------------"
    } | tee -a "${HL_PROBEDUMP:-/dev/null}"
    return 0
}

probe_say() { # echo + relay to the daemon parent's dump file when present
    echo "$1"
    [ -n "${HL_PROBEDUMP:-}" ] && echo "$1" >>"$HL_PROBEDUMP"
    return 0
}

run_probe_and_guard() { # <port> <alias> — measure decode t/s, track best, warn on regression
    local port="$1" alias="$2"
    [ "$PROBE" = 1 ] || return 0
    if ! command -v curl >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
        probe_say ">> probe skipped (needs curl + python3)"
        return 0
    fi
    if ! wait_api_ready "$port" 300; then
        probe_say ">> probe skipped (API not ready after 300s)"
        return 0
    fi
    local tps gpu bucket cfg rec best bcfg bdate
    tps="$(probe_decode_tps "$port" "$alias" 64)"
    if [ -z "$tps" ]; then
        probe_say ">> probe skipped (no valid timing from server)"
        return 0
    fi
    case "$tps" in
    *" loop")
        tps="${tps%% *}"
        probe_say "!! ------------------------------------------------------------------"
        probe_say "!! DEGENERATE OUTPUT: probe response is a repetition loop (${tps} t/s of garbage)"
        probe_say "!! likely causes: KV cache quantized too hard (try --kv q8_0) or sampler settings"
        probe_say "!! ------------------------------------------------------------------"
        return 0 # do not record a looping run as a speed baseline
        ;;
    esac
    probe_say ">> measured decode: ${tps} t/s"
    gpu="$(gpu_name)"
    bucket="$(ctx_bucket "$CONTEXT")"
    cfg="mode=${MODE:-?};off=${NCMOE:-?};mtp=${MTP:-0};kv=${KVTYPE_K:-?};fa=$([ "${FA_ON:-1}" = 1 ] && echo on || echo off)"
    rec="$(state_get best "$alias" "$gpu" "$bucket")"
    if [ -z "$rec" ]; then
        state_put best "$alias" "$gpu" "$bucket" "$cfg" "$tps"
        probe_say ">> speed baseline recorded: ${tps} t/s ($HL_STATE)"
        return 0
    fi
    best="$(printf '%s' "$rec" | cut -f2)"
    bcfg="$(printf '%s' "$rec" | cut -f1)"
    bdate="$(printf '%s' "$rec" | cut -f3)"
    if awk -v a="$tps" -v b="$best" 'BEGIN{exit !(a > b)}'; then
        state_put best "$alias" "$gpu" "$bucket" "$cfg" "$tps"
        probe_say ">> new best decode for this model/GPU/ctx: ${tps} t/s (was ${best})"
    elif awk -v a="$tps" -v b="$best" -v p="$PROBE_REGRESS_PCT" 'BEGIN{exit !(a < b * p / 100)}'; then
        {
            echo "!! ------------------------------------------------------------------"
            echo "!! SPEED REGRESSION: ${tps} t/s vs best-known ${best} t/s ($bdate)"
            echo "!! best config was: $bcfg"
            echo "!! this run:        $cfg"
            echo "!! (threshold ${PROBE_REGRESS_PCT}%; delete the 'best' line in $HL_STATE to reset)"
            echo "!! ------------------------------------------------------------------"
        } | tee -a "${HL_PROBEDUMP:-/dev/null}"
    fi
    return 0 # a probe is telemetry — never let it fail the launch (set -e)
}

# ---- `highllama tune`: measure candidate configs, persist the winner --------
# Launches the real `start` path per candidate (same pattern as
# speed_benchmark/bench.sh), probes decode t/s over 3 short generations, and
# records the winner in $HL_STATE so future `start`s apply it automatically.
cmd_tune() {
    local model="${MODEL:-}" ctx="${CONTEXT:-64k}"
    local fwd=("$@") args=("$@")
    # light scan for -m/-c; the full arg list is still forwarded verbatim
    local i=0
    while [ "$i" -lt "$#" ]; do
        case "${args[$i]}" in
        -m | --model)
            model="${args[$((i + 1))]}"
            i=$((i + 2))
            ;;
        -c | --ctx)
            ctx="${args[$((i + 1))]}"
            i=$((i + 2))
            ;;
        *) i=$((i + 1)) ;;
        esac
    done
    if [ -z "$model" ]; then
        echo "!! tune needs -m <model> (no interactive picker here)" >&2
        exit 1
    fi
    ctx="$(to_tokens "$ctx")"
    if ! [[ "$ctx" =~ ^[0-9]+$ ]]; then
        echo "!! invalid context size (use e.g. 32k, 64k, or a number)" >&2
        exit 1
    fi
    local path=""
    if [ -f "$model" ]; then path="$model"; else path="$(resolve_local_gguf "$model")"; fi
    if [ -z "$path" ]; then
        echo "!! tune needs a local GGUF — download it first: $0 pull" >&2
        exit 1
    fi
    if ! command -v python3 >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
        echo "!! tune needs python3 + curl" >&2
        exit 1
    fi
    BACKEND="${BACKEND:-$(detect_backend)}"

    local alias gpu bucket
    alias="$(basename "$path")"
    alias="${alias%.gguf}"
    gpu="$(gpu_name)"
    bucket="$(ctx_bucket "$ctx")"

    # MTP head available? (separate mtp-*.gguf sibling or embedded nextn head)
    local has_head=""
    if [ -n "$(command find -L "$(dirname "$path")" -maxdepth 1 -type f -iname '*mtp*.gguf' 2>/dev/null |
        command grep -vF "$path" | head -1 || true)" ]; then
        has_head=1
    elif [ "$(model_has_embedded_mtp "$path")" = 1 ]; then
        has_head=1
    fi

    # pre-estimate on a clean GPU to shape the candidate matrix: a running
    # server (or LM Studio) would otherwise hold the VRAM and skew it
    "$SCRIPT_PATH" stop >/dev/null 2>&1 || true
    if command -v lms >/dev/null 2>&1; then
        lms unload --all >/dev/null 2>&1 || true
        sleep 1
    fi
    local free kvb est mode val rest
    free="$(free_vram_mib "$BACKEND")"
    kvb="$(kv_bits "${KVTYPE_K:-${KVTYPE:-q8_0}}")"
    est=""
    [ -n "$free" ] && est="$(python3 "$SCRIPT_DIR/gguf-estimate.py" "$path" "$free" "$ctx" "${PARALLEL:-1}" "$kvb" 2>/dev/null || true)"
    if [ -z "$est" ]; then
        echo "!! tune needs the VRAM estimator (local GGUF + measurable free VRAM)" >&2
        exit 1
    fi
    mode="${est%% *}"
    rest="${est#* }"
    val="${rest%% *}"

    # candidate matrix: label + NCMOE env value + extra start flag
    local labels=() envs=() extras=()
    if [ "$mode" = moe ] && [ "$val" = 0 ]; then
        if [ -n "$has_head" ]; then
            labels=("mtp=off" "mtp=on")
            envs=("" "")
            extras=("--no-mtp" "--mtp")
        else
            echo ">> model fully fits on GPU and has no MTP head — measuring baseline only"
            labels=("baseline")
            envs=("")
            extras=("")
        fi
    elif [ "$mode" = dense ]; then
        labels=("ngl=$val")
        envs=("$val")
        extras=("")
        if [ "$((val - 4))" -gt 0 ]; then
            labels+=("ngl=$((val - 4))")
            envs+=("$((val - 4))")
            extras+=("")
        fi
    else
        labels=("ncmoe=$val" "ncmoe=$((val + 4))")
        envs=("$val" "$((val + 4))")
        extras=("" "")
    fi

    echo ">> tune: $alias on $gpu, ctx=$ctx — ${#labels[@]} candidate(s), ~1-2 min each"
    local port="${PORT:-8089}" results=() best_tps="" best_i="" li log child
    for li in "${!labels[@]}"; do
        echo ">> [$((li + 1))/${#labels[@]}] candidate ${labels[$li]}: starting server..."
        "$SCRIPT_PATH" stop >/dev/null 2>&1 || true
        log="$(mktemp "${TMPDIR:-/tmp}/highllama-tune.XXXXXX")"
        (
            export PROBE=0
            [ -n "${envs[$li]}" ] && export NCMOE="${envs[$li]}"
            # shellcheck disable=SC2086
            exec "$SCRIPT_PATH" start ${fwd[@]+"${fwd[@]}"} --no-embeddings ${extras[$li]:+${extras[$li]}}
        ) >"$log" 2>&1 &
        child=$!
        if ! wait_api_ready "$port" 300; then
            echo "!! candidate ${labels[$li]}: server not ready after 300s — skipped (log kept: $log)"
            results+=("FAILED")
            kill "$child" 2>/dev/null || true
            "$SCRIPT_PATH" stop >/dev/null 2>&1 || true
            continue
        fi
        # 3 probes of 128 tokens (the first doubles as warmup); take the median
        local t1 t2 t3 med eff
        t1="$(probe_decode_tps "$port" "$alias" 128)"
        t2="$(probe_decode_tps "$port" "$alias" 128)"
        t3="$(probe_decode_tps "$port" "$alias" 128)"
        case "$t1 $t2 $t3" in
        *loop*) # a looping candidate is fast garbage — never let it win
            echo "!! candidate ${labels[$li]}: degenerate (looping) output — discarded"
            t1="" t2="" t3=""
            ;;
        esac
        med="$(printf '%s\n' "$t1" "$t2" "$t3" | sort -n |
            awk 'NF{a[++n]=$1} END{if(n)print a[int((n+1)/2)]}')"
        eff="$(command grep -oE 'launching with [^.]*' "$log" | tail -1 || true)"
        kill "$child" 2>/dev/null || true
        "$SCRIPT_PATH" stop >/dev/null 2>&1 || true
        if [ -n "$med" ]; then
            echo ">> [$((li + 1))/${#labels[@]}] ${labels[$li]}: ${med} t/s (${eff:-as requested})"
            results+=("$med")
            if [ -z "$best_tps" ] || awk -v a="$med" -v b="$best_tps" 'BEGIN{exit !(a > b)}'; then
                best_tps="$med"
                best_i="$li"
            fi
        else
            echo "!! candidate ${labels[$li]}: no valid timing — skipped (log kept: $log)"
            results+=("FAILED")
            continue
        fi
        rm -f "$log"
    done

    if [ -z "$best_tps" ]; then
        echo "!! tune: no candidate produced a valid measurement" >&2
        exit 1
    fi
    # persist: MTP verdicts always; non-default offloads only when they beat
    # the estimator default by >5% (avoid pinning noise)
    local cfg=""
    case "${labels[$best_i]}" in
    mtp=on | mtp=off) cfg="${labels[$best_i]}" ;;
    ngl=* | ncmoe=*)
        if [ "$best_i" != 0 ] &&
            { [ "${results[0]}" = FAILED ] ||
                awk -v a="$best_tps" -v b="${results[0]}" 'BEGIN{exit !(a > b * 1.05)}'; }; then
            cfg="${labels[$best_i]}"
        fi
        ;;
    esac
    if [ -n "$cfg" ]; then
        state_put tune "$alias" "$gpu" "$bucket" "$cfg" "$best_tps"
        echo ">> tune: winner '$cfg' (${best_tps} t/s) persisted to $HL_STATE"
        echo ">> future 'start' applies it automatically (explicit flags still win)"
    else
        state_del tune "$alias" "$gpu" "$bucket"
        echo ">> tune: default config is best (${best_tps} t/s) — no override recorded"
    fi
    # seed/refresh the best-known record used by the startup regression guard
    local prev
    prev="$(state_get best "$alias" "$gpu" "$bucket" | cut -f2)"
    if [ -z "$prev" ] || awk -v a="$best_tps" -v b="$prev" 'BEGIN{exit !(a > b)}'; then
        state_put best "$alias" "$gpu" "$bucket" "tuned:${labels[$best_i]}" "$best_tps"
    fi
    exit 0
}

# ---- build requirements per platform (deps subcommand) ---------------------
install_deps() {
    local backend="$1"
    echo ">> installing build requirements for backend=$backend ..."
    if [ "$OS" = "Darwin" ]; then
        xcode-select -p >/dev/null 2>&1 || xcode-select --install || true
        if command -v brew >/dev/null 2>&1; then
            brew install cmake git curl
        else
            echo "!! Homebrew not found (https://brew.sh) — need cmake + git on top of Xcode CLT" >&2
        fi
        [ "$backend" = "mlx" ] && python3 -m pip install --upgrade mlx-lm
        echo ">> deps done."
        return 0
    fi

    local SUDO=""
    [ "$(id -u)" -ne 0 ] && SUDO="sudo"

    if command -v pacman >/dev/null 2>&1; then
        $SUDO pacman -S --needed --noconfirm base-devel cmake git curl python
        case "$backend" in
        cuda) $SUDO pacman -S --needed --noconfirm cuda ;;
        rocm) $SUDO pacman -S --needed --noconfirm rocm-hip-sdk rocminfo ;;
        vulkan) $SUDO pacman -S --needed --noconfirm vulkan-headers vulkan-icd-loader vulkan-tools shaderc spirv-headers ;;
        esac
    elif command -v apt-get >/dev/null 2>&1; then
        $SUDO apt-get update
        $SUDO apt-get install -y build-essential cmake git libcurl4-openssl-dev python3
        case "$backend" in
        cuda) $SUDO apt-get install -y nvidia-cuda-toolkit ||
            echo "!! install the CUDA toolkit from NVIDIA's repo: https://developer.nvidia.com/cuda-downloads" >&2 ;;
        rocm) $SUDO apt-get install -y rocm-hip-sdk rocminfo ||
            echo "!! ROCm needs AMD's repo first: https://rocm.docs.amd.com/projects/install-on-linux/" >&2 ;;
        vulkan) $SUDO apt-get install -y libvulkan-dev glslc vulkan-tools spirv-headers ||
            $SUDO apt-get install -y libvulkan-dev glslang-tools vulkan-tools spirv-headers ;;
        esac
    elif command -v dnf >/dev/null 2>&1; then
        $SUDO dnf install -y gcc-c++ cmake git libcurl-devel python3
        case "$backend" in
        cuda) echo "!! CUDA on Fedora: enable NVIDIA's repo, then: dnf install cuda-toolkit" >&2 ;;
        rocm) $SUDO dnf install -y rocm-hip-devel hipblas-devel rocminfo ||
            echo "!! see https://rocm.docs.amd.com/projects/install-on-linux/" >&2 ;;
        vulkan) $SUDO dnf install -y vulkan-headers vulkan-loader-devel glslc vulkan-tools spirv-headers-devel ;;
        esac
    elif command -v zypper >/dev/null 2>&1; then
        $SUDO zypper install -y gcc-c++ cmake git libcurl-devel python3
        case "$backend" in
        cuda) echo "!! CUDA on openSUSE: add NVIDIA's repo, then: zypper install cuda-toolkit" >&2 ;;
        rocm) echo "!! ROCm on openSUSE: see https://rocm.docs.amd.com/projects/install-on-linux/" >&2 ;;
        vulkan) $SUDO zypper install -y vulkan-headers vulkan-loader-devel shaderc vulkan-tools SPIRV-Headers-devel ;;
        esac
    else
        echo "!! unknown package manager — install manually: C++ toolchain, cmake, git, libcurl dev" >&2
        return 1
    fi
    echo ">> deps done."
}

# ---- clone (if needed) + configure + build llama.cpp (build subcommand) ----
build_llama() {
    local backend="$1" flags=() jobs g cap gfx
    if [ "$backend" = "mlx" ]; then
        echo ">> mlx uses mlx-lm, not llama.cpp — nothing to build (pip install mlx-lm)"
        return 0
    fi
    if [ ! -d "$LLAMA_DIR" ]; then
        echo ">> cloning llama.cpp into $LLAMA_DIR ..."
        git clone https://github.com/ggml-org/llama.cpp "$LLAMA_DIR"
    fi
    case "$backend" in
    cuda)
        [ -d /opt/cuda ] && export CUDAToolkit_ROOT=/opt/cuda
        flags=(-DGGML_CUDA=ON)
        cap="$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -1 | tr -d '. ')"
        [ -n "$cap" ] && flags+=(-DCMAKE_CUDA_ARCHITECTURES="$cap")
        # nvcc often rejects the newest system gcc; prefer an older versioned one
        for g in gcc-15 gcc-14 gcc-13; do
            if command -v "$g" >/dev/null 2>&1; then
                flags+=(-DCMAKE_CUDA_HOST_COMPILER="$(command -v "$g")")
                break
            fi
        done
        ;;
    rocm)
        gfx="$(rocminfo 2>/dev/null | command grep -o 'gfx[0-9a-f]*' | command grep -v '^gfx\(000\)\?$' | head -1 || true)"
        flags=(-DGGML_HIP=ON)
        [ -n "$gfx" ] && flags+=(-DAMDGPU_TARGETS="$gfx" -DGPU_TARGETS="$gfx")
        ;;
    vulkan) flags=(-DGGML_VULKAN=ON) ;;
    metal | cpu) ;; # cmake defaults are right (Metal is on by default on Apple silicon)
    *)
        echo "!! unknown backend '$backend' (cuda|rocm|vulkan|metal|cpu|mlx)" >&2
        return 1
        ;;
    esac
    if [ "$OS" = "Darwin" ]; then jobs="$(sysctl -n hw.ncpu)"; else jobs="$(nproc)"; fi
    echo ">> cmake configure: ${flags[*]:-'(defaults)'}"
    cmake -S "$LLAMA_DIR" -B "$LLAMA_DIR/build" -DCMAKE_BUILD_TYPE=Release ${flags[@]+"${flags[@]}"}
    cmake --build "$LLAMA_DIR/build" --config Release -j "$jobs"
    echo ">> built: $LLAMA_DIR/build/bin/llama-server"
}

update_llama() {
    local backend="$1"
    if [ -d "$LLAMA_DIR" ]; then
        echo ">> updating llama.cpp in $LLAMA_DIR (git pull) ..."
        git -C "$LLAMA_DIR" pull
    else
        echo ">> llama.cpp directory does not exist, cloning first ..."
        git clone https://github.com/ggml-org/llama.cpp "$LLAMA_DIR"
    fi
    build_llama "$backend"
}

# ---- pull: download GGUFs from Hugging Face (LM Studio-style picker) -------
# Default into LM Studio's models dir (publisher/repo/file layout) so LM Studio
# sees pulled models too; fall back to the llama.cpp cache if LM Studio absent.
if [ -z "${PULL_DIR:-}" ]; then
    if [ -d "$HOME/.lmstudio/models" ]; then
        PULL_DIR="$HOME/.lmstudio/models"
    else PULL_DIR="$HOME/.cache/llama.cpp"; fi
fi

human_mib() { awk -v m="$1" 'BEGIN{ if (m >= 1024) printf "%.1fG", m/1024; else printf "%dM", m }'; }

# search HF for GGUF repos -> lines "repo_id<TAB>downloads" (most downloaded first)
hf_search() {
    python3 - "$1" <<'PY'
import json, sys, urllib.parse, urllib.request
q = urllib.parse.quote(sys.argv[1])
url = f"https://huggingface.co/api/models?search={q}&filter=gguf&sort=downloads&direction=-1&limit=25"
req = urllib.request.Request(url, headers={"User-Agent": "highllama"})
for m in json.load(urllib.request.urlopen(req, timeout=30)):
    print(f"{m['id']}\t{m.get('downloads', 0)}")
PY
}

# list a repo's GGUF files -> lines "name<TAB>total_MiB<TAB>file1:MiB1,file2:MiB2,..."
# (multi-part shards grouped into one entry; mmproj excluded; smallest first)
hf_files() {
    python3 - "$1" <<'PY'
import json, re, sys, urllib.request
repo = sys.argv[1]
url = f"https://huggingface.co/api/models/{repo}?blobs=true"
req = urllib.request.Request(url, headers={"User-Agent": "highllama"})
d = json.load(urllib.request.urlopen(req, timeout=30))
groups = {}
for s in d.get("siblings", []):
    f = s.get("rfilename", "")
    if not f.lower().endswith(".gguf") or "mmproj" in f.lower():
        continue
    base = re.sub(r"-\d{5}-of-\d{5}(?=\.gguf$)", "", f)
    g = groups.setdefault(base, {"files": [], "size": 0})
    g["files"].append((f, (s.get("size") or 0) // (1024 * 1024)))
    g["size"] += s.get("size") or 0
for base, g in sorted(groups.items(), key=lambda kv: kv[1]["size"]):
    files = ",".join(f"{name}:{mib}" for name, mib in sorted(g["files"]))
    print(f"{base}\t{g['size'] // (1024 * 1024)}\t{files}")
PY
}

# a repo's vision projector -> one "rfilename:MiB" entry (smallest mmproj), or nothing
hf_mmproj() {
    python3 - "$1" <<'PY'
import json, sys, urllib.request
repo = sys.argv[1]
url = f"https://huggingface.co/api/models/{repo}?blobs=true"
req = urllib.request.Request(url, headers={"User-Agent": "highllama"})
d = json.load(urllib.request.urlopen(req, timeout=30))
files = []
for s in d.get("siblings", []):
    f = s.get("rfilename", "")
    if f.lower().endswith(".gguf") and "mmproj" in f.lower():
        files.append((f, (s.get("size") or 0) // (1024 * 1024)))
if files:
    files.sort(key=lambda t: t[1])  # f16/bf16 projectors are interchangeable: take the smallest
    print(f"{files[0][0]}:{files[0][1]}")
PY
}

pull_files() { # $1 = repo, $2 = comma-separated "rfilename:MiB" entries
    local repo="$1" entry f mib url dest pid rc cur last speed pct
    mkdir -p "$PULL_DIR/$repo" # publisher/repo subdirs, LM Studio layout
    local IFS=','
    for entry in $2; do
        f="${entry%:*}"
        mib="${entry##*:}"
        url="https://huggingface.co/$repo/resolve/main/$f"
        dest="$PULL_DIR/$repo/$(basename "$f")"
        if [ -f "$dest" ]; then
            echo ">> already downloaded: $dest"
            continue
        fi
        echo ">> downloading $f ($(human_mib "$mib"))"
        curl -sL --fail -C - ${HF_TOKEN:+-H "Authorization: Bearer $HF_TOKEN"} \
            -o "$dest.part" "$url" &
        pid=$!
        last="$(($(file_size "$dest.part" 2>/dev/null || echo 0) / 1048576))"
        while kill -0 "$pid" 2>/dev/null; do
            sleep 1
            cur="$(($(file_size "$dest.part" 2>/dev/null || echo 0) / 1048576))"
            speed=$((cur - last))
            last=$cur
            if [ "$mib" -gt 0 ] 2>/dev/null; then
                pct=$((cur * 100 / mib))
                printf '\r   %s / %s  (%d%%)  %d MiB/s     ' \
                    "$(human_mib "$cur")" "$(human_mib "$mib")" "$pct" "$speed"
            else
                printf '\r   %s downloaded  %d MiB/s     ' "$(human_mib "$cur")" "$speed"
            fi
        done
        rc=0
        wait "$pid" || rc=$?
        printf '\n'
        if [ "$rc" -ne 0 ]; then
            echo "!! download failed (curl exit $rc): $f — re-run to resume" >&2
            exit 1
        fi
        mv "$dest.part" "$dest"
        echo ">> saved: $dest"
    done
    echo ">> done. serve it with: $0 -m <name substring>"
}

cmd_pull() {
    local arg="${1:-}" repo="" quant="" idx choice pick base
    command -v python3 >/dev/null 2>&1 || {
        echo "!! pull needs python3" >&2
        exit 1
    }
    command -v curl >/dev/null 2>&1 || {
        echo "!! pull needs curl" >&2
        exit 1
    }

    if [ -z "$arg" ]; then
        printf "Search Hugging Face for GGUF models (q to quit): "
        read -r arg
        { [ -n "$arg" ] && [ "$arg" != "q" ]; } || exit 0
    fi

    # owner/repo[:quant] goes straight to the repo; anything else is a search term
    case "$arg" in
    */*)
        repo="${arg%%:*}"
        case "$arg" in *:*) quant="${arg#*:}" ;; esac
        ;;
    esac

    if [ -z "$repo" ]; then
        local REPOS=() DLS=() id dls
        while IFS=$'\t' read -r id dls; do
            [ -n "$id" ] || continue
            REPOS+=("$id")
            DLS+=("$dls")
        done < <(hf_search "$arg" || true)
        if [ "${#REPOS[@]}" -eq 0 ]; then
            echo "!! no GGUF models on Hugging Face matching '$arg'" >&2
            exit 1
        fi
        echo "GGUF models on Hugging Face matching '$arg':"
        idx=1
        for id in "${REPOS[@]}"; do
            printf "  %2d) %-65s %10s downloads\n" "$idx" "$id" "${DLS[$((idx - 1))]}"
            idx=$((idx + 1))
        done
        printf "Select model [1-%d] (q to quit): " "${#REPOS[@]}"
        read -r choice
        [ "$choice" = "q" ] && exit 0
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#REPOS[@]}" ]; then
            echo "Invalid selection."
            exit 1
        fi
        repo="${REPOS[$((choice - 1))]}"
    fi

    echo ">> fetching file list for $repo ..."
    local BASES=() SIZES=() FILESL=() mib files
    while IFS=$'\t' read -r base mib files; do
        [ -n "$base" ] || continue
        if [ -n "$quant" ]; then
            printf '%s' "$base" | command grep -qi -- "$quant" || continue
        fi
        BASES+=("$base")
        SIZES+=("$mib")
        FILESL+=("$files")
    done < <(hf_files "$repo" || true)
    if [ "${#BASES[@]}" -eq 0 ]; then
        echo "!! no .gguf files in $repo${quant:+ matching '$quant'}" >&2
        exit 1
    fi

    if [ "${#BASES[@]}" -eq 1 ]; then
        pick=0
        echo ">> $(human_mib "${SIZES[0]}")  ${BASES[0]}"
    else
        echo "Available files in $repo:"
        idx=1
        for base in "${BASES[@]}"; do
            printf "  %2d) %-8s %s\n" "$idx" "$(human_mib "${SIZES[$((idx - 1))]}")" "$base"
            idx=$((idx + 1))
        done
        printf "Select file [1-%d] (q to quit): " "${#BASES[@]}"
        read -r choice
        [ "$choice" = "q" ] && exit 0
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#BASES[@]}" ]; then
            echo "Invalid selection."
            exit 1
        fi
        pick=$((choice - 1))
    fi
    pull_files "$repo" "${FILESL[$pick]}"
    # vision models ship the projector as a separate file; grab it too so `start`
    # can auto-attach it (--mmproj). Small next to the weights, skipped if present.
    local mmproj
    mmproj="$(hf_mmproj "$repo" 2>/dev/null || true)"
    if [ -n "$mmproj" ]; then
        echo ">> vision projector in $repo — fetching it as well"
        pull_files "$repo" "$mmproj"
    fi
}

# ---- help -------------------------------------------------------------------
usage() {
    cat <<'EOF'
highllama — launch ANY GGUF model on llama.cpp server (NVIDIA / AMD / Apple)

USAGE:
  highllama start [options]      start the server (interactive picker if no -m)
  highllama <command> [args]

COMMANDS:
  start [options]    start the llama.cpp server (see START OPTIONS)
  pull [term|repo]   browse/search Hugging Face and download a GGUF
  ls                 list local models (numbered picker view)
  list               list local models with sizes + full paths
  status             show whether a server is running
  stop               stop the running server (and systemd user unit)
  reload [options]   stop the server and restart with new options
  restart [options]  stop + start with the same settings as the last start
                     (picker choice included; no tty needed). extras win,
                     e.g. `highllama restart --daemon`
  tune [options]     measure the fastest config (MTP / offload) for a model on
                     this hardware and persist it; 'start' applies it after
  logs [args]        stream daemon logs (journalctl -t highllama)
  deps [backend]     install build requirements (pacman/apt/dnf/zypper/brew)
  build [backend]    clone (if needed) + cmake-build llama.cpp
  update [backend]   git pull llama.cpp + rebuild
  help, -h, --help   show this help

START OPTIONS:
  -m, --model <id>         local GGUF path, local substring, or HF repo:quant
  -c, --ctx <size>         context: 32k / 64k / 128k or raw tokens (default 64k)
      --ncmoe <n|N%>       MoE expert layers pinned to CPU, as a count or a share of
                           the model's layers (default: auto by VRAM, or a model preset)
  -t, --threads <n>        CPU threads (default: physical cores)
      --kv <type>          KV cache quant, both sides: q8_0 (default) | q4_0 | f16
      --kv-k <type>        K-cache quant only (default q8_0; keep symmetric with -v)
      --kv-v <type>        V-cache quant only (default q8_0; FA kernels need k==v)
      --fa <mode>          flash-attn: auto|on|off (default auto). auto keeps FA on; KV
                           defaults to symmetric q8_0 (mismatched k/v -> CPU). off=non-FA (f16)
      --dry <mult>         DRY sampler multiplier (default 0 = off). warning: breaks verbatim
                           long literals (paths/UUIDs) in agent use; 0.8 was the old default
      --draft, -md <id>    draft model for speculative decoding
      --mtp                force multi-token prediction on (default: auto — on when
                           the model ships an MTP head: mtp- sibling or embedded nextn)
      --no-mtp             disable MTP even if the model has a head
      --mtp-nmax <n>       MTP tokens drafted per step (default 2)
      --chat-template <f>  override the GGUF's Jinja chat template (file path)
      --host <addr>        bind address (default 0.0.0.0)
      --port <n>           port (default 8089; auto-advances if busy)
      --backend <b>        cuda|rocm|vulkan|metal|mlx|cpu (default: autodetect)
  -d, --daemon             run in background, logs -> journal
      --no-embeddings      don't also serve the embeddings model
      --no-probe           skip the startup decode-speed probe / regression check
      -- <args>            pass remaining args straight to llama-server

Every option is also settable via env var (flag wins):
  MODEL CONTEXT NCMOE THREADS KVTYPE KVTYPE_K KVTYPE_V FA DRY DRAFT MTP MTP_NMAX TEMPLATE EMBED_MODEL HOST PORT BACKEND PROBE PROBE_REGRESS_PCT HL_STATE HL_PRESETS

PRESETS:
  Per-model-family defaults (NCMOE, KVTYPE, MTP, EXTRA) fill whatever flags, env
  and 'tune' records leave unset — so plain 'start'/'reload'/'restart' get the
  right offload for a known model. Built in: the 35B-A3B family (Qwen3.6,
  AgentWorld, Ornith-1.x) -> NCMOE=73% EXTRA="-ub 2048 -b 2048". Add your own in
  ~/.config/highllama/presets, one per line:  <glob>[|<glob>]  KEY=VAL ...

EXAMPLES:
  highllama start                                  interactive picker, 64k ctx
  highllama start -m unsloth/gpt-oss-20b-GGUF:Q8_0
  highllama start -m /path/to/model.gguf -c 128k
  highllama start -m <model> --draft unsloth/Qwen3-0.6B-GGUF:Q8_0
  highllama pull qwen3 coder
  highllama pull ornith-ai/Ornith-1.5-35B-A3B-GGUF:Q4_K_M   (fetches the mmproj too)
  highllama start -m ornith-1.5 -c 128k            preset -> n-cpu-moe=73%, -ub/-b 2048
  highllama reload -c 128k --mtp
EOF
}

# ---- subcommands: start / ls / list / pull / stop / status / deps / build ----
case "${1:-}" in
"" | help | -h | --help)
    usage
    exit 0
    ;;
start)
    shift # launch verb; remaining args fall through to arg parsing below
    ;;
tune)
    shift
    cmd_tune "$@"
    ;;
ls)
    echo "Available local models:"
    if ! print_model_menu; then
        echo "No local GGUF models found. Download one with: $0 pull"
        exit 1
    fi
    exit 0
    ;;
list | --list)
    echo "Local GGUF models (usable with -m <substring>, no re-download):"
    list_local_models
    exit 0
    ;;
stop)
    # a systemd-managed server must be stopped through systemd, or
    # Restart=on-failure just brings it back after the pkill. "activating"
    # covers the RestartSec window where the unit isn't active yet but a
    # respawn is pending; reset-failed cancels that pending restart.
    stopped_unit=""
    if command -v systemctl >/dev/null 2>&1; then
        state="$(systemctl --user is-active highllama.service 2>/dev/null || true)"
        if [ "$state" = "active" ] || [ "$state" = "activating" ]; then
            echo ">> stopping systemd user service..."
            systemctl --user stop highllama.service
            systemctl --user reset-failed highllama.service 2>/dev/null || true
            stopped_unit=1
        fi
    fi
    if [ -n "$(server_running)" ]; then
        echo ">> stopping server..."
        pkill -x llama-server 2>/dev/null || true
        pkill -f 'mlx_lm.server|mlx_lm server' 2>/dev/null || true
        # SIGTERM shutdown can take a few seconds (VRAM teardown); wait for
        # the process to actually die instead of declaring victory blind
        for _ in $(seq 1 20); do
            [ -n "$(server_running)" ] || break
            sleep 0.5
        done
        if [ -n "$(server_running)" ]; then
            echo ">> still alive after 10s, sending SIGKILL..."
            pkill -9 -x llama-server 2>/dev/null || true
            pkill -9 -f 'mlx_lm.server|mlx_lm server' 2>/dev/null || true
            sleep 1
        fi
        if [ -n "$(server_running)" ]; then
            echo "!! failed to stop: $(server_running)" >&2
            exit 1
        fi
        echo ">> stopped."
    elif [ -n "$stopped_unit" ]; then
        echo ">> stopped."
    else
        echo ">> no server running."
    fi
    exit 0
    ;;
status)
    running="$(server_running)"
    if [ -n "$running" ]; then
        echo ">> RUNNING: $running"
    else
        echo ">> no server running."
    fi
    exit 0
    ;;
logs)
    if ! command -v journalctl >/dev/null 2>&1; then
        echo "!! journalctl not found (logs are only written to the system journal on systemd systems)" >&2
        exit 1
    fi
    shift
    if [ $# -eq 0 ]; then
        exec journalctl -t highllama -f
    else
        exec journalctl -t highllama "$@"
    fi
    ;;
pull | download)
    shift
    cmd_pull "$*"
    exit 0
    ;;
deps | install-deps)
    install_deps "${2:-$(detect_backend)}"
    exit 0
    ;;
build)
    build_llama "${2:-$(detect_backend)}"
    exit 0
    ;;
update)
    update_llama "${2:-$(detect_backend)}"
    exit 0
    ;;
reload)
    shift
    echo ">> reloading server..."
    if ! "$SCRIPT_PATH" stop >/dev/null 2>&1; then
        echo "!! failed to stop the existing server" >&2
        exit 1
    fi
    exec "$SCRIPT_PATH" start "$@"
    ;;
restart)
    # stop + start with the exact settings of the last `start` (recorded in
    # $HL_LAST at launch, picker choice included — works without a tty).
    # extra flags are appended and win, e.g.: highllama restart --daemon
    shift
    HL_LAST="${HL_LAST:-${XDG_CONFIG_HOME:-$HOME/.config}/highllama/last-start.env}"
    if [ ! -f "$HL_LAST" ]; then
        echo "!! no recorded launch ($HL_LAST not found)" >&2
        echo "!! run 'highllama start ...' once — every start records itself for restart" >&2
        exit 1
    fi
    HL_LAST_EXTRA=()
    # shellcheck disable=SC1090
    . "$HL_LAST"
    echo ">> restarting last launch: $(basename "$MODEL") ctx=$CONTEXT${HL_LAST_EXTRA[0]+ extra:${HL_LAST_EXTRA[*]}}"
    if ! "$SCRIPT_PATH" stop; then
        echo "!! failed to stop the existing server" >&2
        exit 1
    fi
    export MODEL CONTEXT NCMOE THREADS KVTYPE_K KVTYPE_V FA DRY DRAFT MTP MTP_NMAX TEMPLATE EMBED_MODEL HOST PORT BACKEND PARALLEL
    exec "$SCRIPT_PATH" start "$@" ${HL_LAST_EXTRA[@]+-- "${HL_LAST_EXTRA[@]}"}
    ;;
esac

# ---- arg parsing ----------------------------------------------------------
while [ $# -gt 0 ]; do
    case "$1" in
    -m | --model)
        MODEL="$2"
        shift 2
        ;;
    -c | --ctx)
        CONTEXT="$2"
        shift 2
        ;;
    --ncmoe)
        NCMOE="$2"
        shift 2
        ;;
    -t | --threads)
        THREADS="$2"
        shift 2
        ;;
    --kv)
        KVTYPE="$2"
        shift 2
        ;;
    --kv-k)
        KVTYPE_K="$2"
        shift 2
        ;;
    --kv-v)
        KVTYPE_V="$2"
        shift 2
        ;;
    --fa)
        FA="$2"
        shift 2
        ;;
    --dry)
        DRY="$2"
        shift 2
        ;;
    --draft | -md)
        DRAFT="$2"
        shift 2
        ;;
    --mtp)
        MTP=on
        shift
        ;;
    --no-mtp)
        MTP=off
        shift
        ;;
    --mtp-nmax)
        MTP_NMAX="$2"
        shift 2
        ;;
    --chat-template | --template)
        TEMPLATE="$2"
        shift 2
        ;;
    --host)
        HOST="$2"
        shift 2
        ;;
    --port)
        PORT="$2"
        shift 2
        ;;
    --backend)
        BACKEND="$2"
        shift 2
        ;;
    -d | --daemon)
        DAEMON=1
        shift
        ;;
    --no-embeddings)
        ALLMODELS=""
        shift
        ;;
    --no-probe)
        PROBE=0
        shift
        ;;
    --)
        shift
        EXTRA+=("$@")
        break
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        EXTRA+=("$1")
        shift
        ;;
    esac
done

[ -n "$BACKEND" ] || BACKEND="$(detect_backend)"
[ -n "$THREADS" ] || THREADS="$(physical_cores)"
# Precedence: --kv-k/--kv-v (per side) > --kv (both sides) > default (q8_0 both).
# The KV cache defaults SYMMETRIC (k==v): CUDA flash-attn kernels are only built
# for matching k/v types unless GGML_CUDA_FA_ALL_QUANTS is set (it isn't here), so
# a mismatched cache returns no GPU kernel and attention falls back to CPU (~14x
# slower prefill). q8_0 is near-lossless and half the VRAM of f16, which keeps
# more layers/experts on GPU at long context. Resolve to concrete per-side types
# so everything downstream (estimate, preset, launch) is explicit.
KV_AUTO="${KV_AUTO:-}" # no explicit KV choice: the offload estimator may step
# q8_0 down to q4_0 when that's what keeps the whole model (and MTP) on the GPU.
# Inherited from the daemon parent (it passes resolved KVTYPE_K/V to the child).
[ -z "${KVTYPE_K}${KVTYPE_V}${KVTYPE}" ] && KV_AUTO=1
KVTYPE_K="${KVTYPE_K:-${KVTYPE:-q8_0}}"
KVTYPE_V="${KVTYPE_V:-${KVTYPE:-q8_0}}"
echo ">> backend=$BACKEND"

# ---- if a server is already up, just report it and exit -------------------
running="$(server_running)"
if [ -n "$running" ]; then
    rport="$(printf '%s\n' "$running" | command grep -oE -- '--port [0-9]+' | command grep -oE '[0-9]+' | head -1)"
    echo ">> A server is already running:"
    echo "   $running"
    [ -n "$rport" ] && echo ">> Endpoint: http://${HOST}:${rport}/v1"
    echo ">> To switch models: highllama reload [new flags]   (or highllama stop, then run again)"
    exit 0
fi

# ---- pick a free port (auto-advance if the requested one is busy) ----------
orig_port="$PORT"
while port_busy "$PORT"; do
    PORT=$((PORT + 1))
    if [ "$PORT" -gt $((orig_port + 20)) ]; then
        echo "!! no free port found near $orig_port" >&2
        exit 1
    fi
done
[ "$PORT" != "$orig_port" ] && echo ">> port $orig_port busy -> using $PORT"

# ---- MLX backend: hand off to mlx_lm.server (no GGUF machinery) ------------
if [ "$BACKEND" = "mlx" ]; then
    if [ -n "$DAEMON" ]; then
        echo "!! --daemon is not supported with the mlx backend (no journal on macOS)" >&2
        exit 1
    fi
    if [ "$OS" != "Darwin" ]; then
        echo "!! mlx backend only works on macOS (Apple silicon)" >&2
        exit 1
    fi
    if [ -z "$MODEL" ]; then
        echo "!! mlx backend needs -m <hf-repo> (e.g. mlx-community/Qwen3-8B-4bit)" >&2
        exit 1
    fi
    if command -v lms >/dev/null 2>&1; then
        echo ">> Unloading LM Studio models to free memory..."
        lms unload --all || true
    fi
    echo ">> model=$MODEL"
    echo ">> serving http://${HOST}:${PORT}/v1  (Ctrl-C to stop)"
    if command -v mlx_lm.server >/dev/null 2>&1; then
        exec mlx_lm.server --model "$MODEL" --host "$HOST" --port "$PORT" ${EXTRA[@]+"${EXTRA[@]}"}
    else
        exec python3 -m mlx_lm server --model "$MODEL" --host "$HOST" --port "$PORT" ${EXTRA[@]+"${EXTRA[@]}"}
    fi
fi

# ---- no model specified -> interactive picker (dynamic mode) ---------------
if [ -z "$MODEL" ]; then
    if [ ! -t 0 ]; then # systemd / pipes: no tty for the picker
        echo "!! no MODEL set and no tty for the interactive picker" >&2
        echo "!! set MODEL= (e.g. in ~/.config/highllama/highllama.env) or pass -m" >&2
        exit 1
    fi
    echo "Available local models:"
    if ! print_model_menu; then
        echo "No local GGUF models found. Specify one to download: $0 -m <hf-repo:quant>"
        exit 1
    fi
    printf "Select model [1-%d] (q to quit): " "${#MODELS[@]}"
    read -r choice
    [ "$choice" = "q" ] && exit 0
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#MODELS[@]}" ]; then
        echo "Invalid selection."
        exit 1
    fi
    MODEL="${MODELS[$((choice - 1))]}"
    echo ">> selected: $(model_repo_label "$MODEL")/$(basename "$MODEL")"
fi

# ---- record the resolved launch for `highllama restart` --------------------
# Written after the picker so MODEL is final. The daemon child re-enters start
# with HL_CMDDUMP set and identical env — skip there, the parent already saved.
if [ -z "${HL_CMDDUMP:-}" ]; then
    HL_LAST="${HL_LAST:-${XDG_CONFIG_HOME:-$HOME/.config}/highllama/last-start.env}"
    mkdir -p "$(dirname "$HL_LAST")"
    _last_tmp="$(mktemp "$(dirname "$HL_LAST")/.last-start.XXXXXX")"
    {
        echo "# resolved launch, written by 'highllama start' — replayed by 'highllama restart'"
        for _v in MODEL CONTEXT NCMOE THREADS KVTYPE_K KVTYPE_V FA DRY DRAFT MTP MTP_NMAX TEMPLATE EMBED_MODEL HOST PORT BACKEND PARALLEL; do
            printf '%s=%q\n' "$_v" "${!_v}"
        done
        printf 'HL_LAST_EXTRA=('
        printf ' %q' ${EXTRA[@]+"${EXTRA[@]}"}
        printf ' )\n'
    } >"$_last_tmp"
    mv "$_last_tmp" "$HL_LAST"
fi

# ---- daemon mode: re-exec detached, output to the system journal -----------
# Runs after the picker so `highllama --daemon` can still ask interactively;
# the child gets every resolved setting via env vars (all env-overridable).
if [ -n "$DAEMON" ]; then
    if ! command -v systemd-cat >/dev/null 2>&1; then
        echo "!! --daemon needs systemd-cat to write logs to the journal" >&2
        exit 1
    fi
    echo ">> starting in background (logs -> journal, tag 'highllama')"
    # the child launches detached under systemd-cat, so its command-line echo
    # goes to the journal; have it also drop the resolved line here so we can
    # show it on this terminal once the server is up.
    CMDDUMP="$(mktemp "${TMPDIR:-/tmp}/highllama-cmd.XXXXXX")"
    # the probe runs in the child (it knows the final config after OOM retries);
    # it drops its result here so this terminal can echo it once ready.
    PROBEDUMP=""
    [ "$PROBE" = 1 ] && PROBEDUMP="$(mktemp "${TMPDIR:-/tmp}/highllama-probe.XXXXXX")"
    setsid env MODEL="$MODEL" CONTEXT="$CONTEXT" NCMOE="$NCMOE" THREADS="$THREADS" \
        KVTYPE="$KVTYPE" KVTYPE_K="$KVTYPE_K" KVTYPE_V="$KVTYPE_V" KV_AUTO="$KV_AUTO" FA="$FA" DRY="$DRY" \
        DRAFT="$DRAFT" MTP="$MTP" MTP_NMAX="$MTP_NMAX" \
        TEMPLATE="$TEMPLATE" IGNORE_TEMPLATE="${IGNORE_TEMPLATE:-}" \
        EMBED_MODEL="$EMBED_MODEL" EMBED_POOLING="${EMBED_POOLING:-}" EMBED_CTX="${EMBED_CTX:-}" \
        HOST="$HOST" PORT="$PORT" \
        BACKEND="$BACKEND" PARALLEL="$PARALLEL" HL_CMDDUMP="$CMDDUMP" \
        PROBE="$PROBE" PROBE_REGRESS_PCT="$PROBE_REGRESS_PCT" HL_STATE="$HL_STATE" \
        HL_PROBEDUMP="$PROBEDUMP" \
        systemd-cat -t highllama "$SCRIPT_PATH" start ${EXTRA[@]+-- "${EXTRA[@]}"} \
        </dev/null >/dev/null 2>&1 &
    DPID=$!
    # wait for the server to come up (model load can take a while)
    for _ in $(seq 1 240); do
        if ! kill -0 "$DPID" 2>/dev/null && [ -z "$(server_running)" ]; then
            echo "!! exited before the server became ready — see: journalctl -t highllama -e" >&2
            rm -f "$CMDDUMP" "$PROBEDUMP"
            exit 1
        fi
        if port_busy "$PORT"; then
            if [ -s "$CMDDUMP" ]; then echo ">> llama-server:"; sed 's/^/   /' "$CMDDUMP"; fi
            rm -f "$CMDDUMP"
            echo ">> ready: http://${HOST}:${PORT}/v1"
            # relay the child's decode probe (it needs a few seconds to generate).
            # wait for the probe verdict itself — degradation banners land in the
            # dump earlier, while the model is still loading.
            if [ -n "$PROBEDUMP" ]; then
                for _ in $(seq 1 180); do
                    command grep -qE 'measured decode|probe skipped' "$PROBEDUMP" 2>/dev/null && break
                    sleep 0.5
                done
                if [ -s "$PROBEDUMP" ]; then
                    sleep 1 # the regression banner (if any) lands just after the measured line
                    cat "$PROBEDUMP"
                else
                    echo ">> probe result not in yet — see: journalctl -t highllama -f"
                fi
                rm -f "$PROBEDUMP"
            fi
            echo ">> logs:  journalctl -t highllama -f"
            echo ">> stop:  highllama stop"
            exit 0
        fi
        sleep 0.5
    done
    if [ -s "$CMDDUMP" ]; then echo ">> llama-server:"; sed 's/^/   /' "$CMDDUMP"; fi
    rm -f "$CMDDUMP" "$PROBEDUMP"
    echo ">> not ready after 120s (large model / first download?)"
    echo ">> follow progress: journalctl -t highllama -f"
    exit 0
fi

# ---- normalize context (accepts 32k / 64k / 128k or a raw token count) -----
CONTEXT="$(to_tokens "$CONTEXT")"
if ! [[ "$CONTEXT" =~ ^[0-9]+$ ]]; then
    echo "!! invalid context size: '$CONTEXT' (use e.g. 32k, 64k, 128k, or a number)" >&2
    exit 1
fi

# NCMOE (expert offload) is computed after `lms unload`, so the estimate sees
# the real free VRAM — see the smart-offload block below.

# runtime library paths (only where the toolkit lives outside the loader path)
case "$BACKEND" in
cuda) [ -d /opt/cuda/lib64 ] && export LD_LIBRARY_PATH="/opt/cuda/lib64:${LD_LIBRARY_PATH:-}" ;;
rocm) [ -d /opt/rocm/lib ] && export LD_LIBRARY_PATH="/opt/rocm/lib:${LD_LIBRARY_PATH:-}" ;;
esac

# ---- model source resolution (avoid re-downloading what you already have) ----
#   1) exact local file path -> use it
#   2) substring match against local GGUFs (LM Studio + caches) -> use it
#   3) otherwise treat as HF repo tag -> -hf (downloads, or reuses HF cache)
MODEL_ARGS=()
if [ -f "$MODEL" ]; then
    MODEL_ARGS=(-m "$MODEL")
    echo ">> using local file: $MODEL"
else
    LOCAL_HIT="$(resolve_local_gguf "$MODEL")"
    if [ -n "$LOCAL_HIT" ]; then
        MODEL_ARGS=(-m "$LOCAL_HIT")
        echo ">> matched local model (no download): $LOCAL_HIT"
    else
        MODEL_ARGS=(-hf "$MODEL")
        echo ">> no local match; fetching from Hugging Face (reuses cache if present): $MODEL"
    fi
fi

# ---- friendly alias (clean name reported by /v1/models -> opencode picker) -
case "${MODEL_ARGS[0]}" in
-m)
    ALIAS="$(basename "${MODEL_ARGS[1]}")"
    ALIAS="${ALIAS%.gguf}"
    ;;
-hf)
    ALIAS="${MODEL##*/}"
    ALIAS="${ALIAS%%:*}"
    ;;
*) ALIAS="model" ;;
esac

# ---- vision: auto-attach a multimodal projector when one is available -------
# Any model that ships (or has a matching) mmproj gains image input automatically.
# A local model only (-m); for -hf downloads we can't point at a local projector.
# An explicit `-- --mmproj <file>` passthrough always wins (we skip auto-detect).
MMPROJ_HIT=""
MMPROJ_ARGS=()
if [ "${MODEL_ARGS[0]}" = "-m" ]; then
    case " ${EXTRA[*]-} " in
    *" --mmproj "*) : ;; # user supplied one explicitly
    *)
        MMPROJ_HIT="$(resolve_mmproj_for "${MODEL_ARGS[1]}")"
        if [ -n "$MMPROJ_HIT" ]; then
            MMPROJ_ARGS=(--mmproj "$MMPROJ_HIT")
            echo ">> vision: auto-attaching projector $(basename "$MMPROJ_HIT")"
        fi
        ;;
    esac
fi

# ---- tuned overrides (from `highllama tune`) --------------------------------
# Apply the measured winner for this (model, GPU, ctx band). Explicit user
# knobs always win: MTP only applies while still 'auto', offload only while
# NCMOE is unset.
TUNED="$(state_get tune "$ALIAS" "$(gpu_name)" "$(ctx_bucket "$CONTEXT")" || true)"
TUNED_APPLIED="" # suppresses the degraded-offload banner: tune already measured
# this ctx band and picked the winner deliberately
if [ -n "$TUNED" ]; then
    TUNED_CFG="$(printf '%s' "$TUNED" | cut -f1)"
    TUNED_DATE="$(printf '%s' "$TUNED" | cut -f3)"
    for kvp in ${TUNED_CFG//;/ }; do
        case "$kvp" in
        mtp=on | mtp=off)
            if [ "${MTP:-auto}" = "auto" ]; then
                MTP="${kvp#mtp=}"
                TUNED_APPLIED=1
                echo ">> tuned: MTP ${MTP} for this model/GPU/ctx (measured $TUNED_DATE; --mtp/--no-mtp overrides, '$0 tune' re-measures)"
            fi
            ;;
        ngl=* | ncmoe=*)
            if [ -z "$NCMOE" ]; then
                NCMOE="${kvp#*=}"
                TUNED_APPLIED=1
                echo ">> tuned: offload ${kvp} for this model/GPU/ctx (measured $TUNED_DATE; --ncmoe overrides, '$0 tune' re-measures)"
            fi
            ;;
        esac
    done
fi

# ---- model presets (see MODEL_PRESETS): fill what flags/env/tune left unset ---
if [ "${MODEL_ARGS[0]}" = "-m" ]; then
    PRESET_LABEL="$(model_repo_label "${MODEL_ARGS[1]}")/$ALIAS"
else
    PRESET_LABEL="$MODEL"
fi
PRESET_LINE="$(preset_lookup "$PRESET_LABEL")"
if [ -n "$PRESET_LINE" ]; then
    PRESET_APPLIED=()
    eval "declare -a _pkv=($PRESET_LINE)" # split like a shell line, so EXTRA="a b" stays one value
    # shellcheck disable=SC2154 # _pkv is assigned by the eval above
    for _kv in "${_pkv[@]}"; do
        case "$_kv" in
        NCMOE=*)
            if [ -z "$NCMOE" ]; then
                NCMOE="${_kv#*=}"
                PRESET_APPLIED+=("$_kv")
            fi
            ;;
        KVTYPE=*)
            if [ -n "$KV_AUTO" ]; then
                KVTYPE_K="${_kv#*=}"
                KVTYPE_V="${_kv#*=}"
                KV_AUTO=""
                PRESET_APPLIED+=("$_kv")
            fi
            ;;
        MTP=*)
            if [ "${MTP:-auto}" = auto ]; then
                MTP="${_kv#*=}"
                PRESET_APPLIED+=("$_kv")
            fi
            ;;
        EXTRA=*)
            read -ra _pextra <<<"${_kv#*=}"
            _padd=()
            _i=0
            while [ "$_i" -lt "${#_pextra[@]}" ]; do
                _flag="${_pextra[$_i]}"
                _val=""
                _i=$((_i + 1))
                # a flag consumes the next word as its value unless that is another flag
                if [ "$_i" -lt "${#_pextra[@]}" ] && [[ "${_pextra[$_i]}" != -* ]]; then
                    _val="${_pextra[$_i]}"
                    _i=$((_i + 1))
                fi
                case " ${EXTRA[*]-} " in *" $_flag "*) continue ;; esac # user passed it: theirs wins
                _padd+=("$_flag")
                [ -n "$_val" ] && _padd+=("$_val")
            done
            if [ "${#_padd[@]}" -gt 0 ]; then
                EXTRA=("${_padd[@]}" ${EXTRA[@]+"${EXTRA[@]}"}) # user's flags come last -> win
                PRESET_APPLIED+=("EXTRA=\"${_padd[*]}\"")
            fi
            ;;
        esac
    done
    if [ "${#PRESET_APPLIED[@]}" -gt 0 ]; then
        echo ">> preset: ${PRESET_APPLIED[*]}  (model preset matched '$PRESET_LABEL'; flags/env/tune override, edit $HL_PRESETS)"
    fi
fi

# ---- optional speculative decoding ---------------------------------------
# MTP (multi-token prediction) and --draft both configure a draft model, so they
# are mutually exclusive. MTP runs the draft head against the target model via
# llama.cpp's draft-mtp speculative type. MTP mode is auto|on|off (default auto):
# 'auto' enables it whenever a LOCAL model actually ships an MTP head and stays
# off otherwise; 'on' (--mtp) forces it; 'off' (--no-mtp) disables it.

# Normalize the MTP intent (accepts legacy MTP=1/0 too). MTP is rewritten below
# to the resolved flag downstream code checks: "" = off, 1 = on.
case "$MTP" in
1 | on | true | yes) MTP_MODE=on ;;
0 | off | no | false) MTP_MODE=off ;;
*) MTP_MODE=auto ;;
esac
if [ "$MTP_MODE" != off ] && [ -n "$DRAFT" ]; then
    # --draft configures its own draft model. An explicit --mtp alongside it is a
    # conflict; in auto mode, defer to the explicit draft model.
    if [ "$MTP_MODE" = on ]; then
        echo "!! --mtp and --draft are mutually exclusive (both set up the draft model)" >&2
        exit 1
    fi
    MTP_MODE=off
fi

SPEC_ARGS=()
MTP="" # resolved flag: "" = off, 1 = on (set only when a usable head is found)
MTP_DRAFT="" # resolved local mtp- head path (also reused by router mode)
if [ "$MTP_MODE" != off ]; then
    # Find an MTP head: a separate 'mtp-*.gguf' sibling (gemma-4 style) or one
    # embedded in the main GGUF (unsloth Qwen3.6, `nextn` metadata). We can only
    # probe LOCAL files; for -hf repos we can't without downloading.
    mtp_sib=""
    embedded=""
    if [ "${MODEL_ARGS[0]}" = "-m" ]; then
        mtp_dir="$(dirname "${MODEL_ARGS[1]}")"
        mtp_sib="$(command find -L "$mtp_dir" -maxdepth 1 -type f -iname '*mtp*.gguf' 2>/dev/null |
            command grep -vF "${MODEL_ARGS[1]}" | sort | head -1 || true)"
        [ -z "$mtp_sib" ] && [ "$(model_has_embedded_mtp)" = 1 ] && embedded=1
    fi

    if [ -n "$mtp_sib" ]; then
        # llama.cpp only auto-discovers the bundled 'mtp-' sibling on the -hf path,
        # so for a local file locate it ourselves and pass it explicitly with -md.
        MTP=1
        MTP_DRAFT="$mtp_sib"
        SPEC_ARGS=(--spec-type draft-mtp --spec-draft-n-max "$MTP_NMAX" -ngld 99 -md "$mtp_sib")
        echo ">> MTP: draft head (local sibling) $mtp_sib"
    elif [ -n "$embedded" ]; then
        # Embedded head: llama.cpp builds the draft context against the target
        # model itself, so no -md is needed.
        MTP=1
        SPEC_ARGS=(--spec-type draft-mtp --spec-draft-n-max "$MTP_NMAX" -ngld 99)
        echo ">> MTP: using the head embedded in ${MODEL_ARGS[1]}"
    elif [ "${MODEL_ARGS[0]}" != "-m" ] && [ "$MTP_MODE" = on ]; then
        # -hf repo: can't probe cheaply. Only trust it when explicitly forced on;
        # rely on llama.cpp to auto-discover the repo's 'mtp-' sibling.
        MTP=1
        SPEC_ARGS=(--spec-type draft-mtp --spec-draft-n-max "$MTP_NMAX" -ngld 99)
        echo ">> MTP: relying on the 'mtp-' head auto-detected from the -hf repo"
    elif [ "$MTP_MODE" = on ]; then
        # Explicitly requested but no head found on a local model. Rather than let
        # llama.cpp abort at load, serve without MTP — it's a decode-speed
        # optimization only, so output is unaffected.
        echo "!! MTP requested but $(basename "${MODEL_ARGS[1]}") has no MTP head (no 'mtp-*.gguf' sibling, no embedded nextn head) — disabling MTP" >&2
    fi
    # auto + no head (local or -hf): silently stays off.
fi

if [ -z "$MTP" ] && [ -n "$DRAFT" ]; then
    if [ -f "$DRAFT" ]; then SPEC_ARGS=(-md "$DRAFT"); else SPEC_ARGS=(--hf-repo-draft "$DRAFT"); fi
    SPEC_ARGS+=(-ngld 99 --spec-draft-n-max 16 --spec-draft-n-min 0)
fi

# ---- flash-attention resolution -------------------------------------------
FA_ON=1
FORCE_F16=0   # --fa off (non-FA GPU path) can't use a quantized KV cache
case "$FA" in
on)  FA_ON=1 ;;
off) FA_ON=0; FORCE_F16=1 ;;
auto) FA_ON=1 ;;
*)
    echo "!! --fa must be auto|on|off (got '$FA')" >&2; exit 1 ;;
esac

# KV cache type resolution:
#  - --fa off (non-FA GPU path): llama.cpp requires an f16 KV cache.
#  - flash-attn on: the CUDA FA kernels are only built for a SYMMETRIC cache
#    (k==v: f16/f16, q4_0/q4_0, q8_0/q8_0, bf16/bf16) unless GGML_CUDA_FA_ALL_QUANTS
#    is set (it isn't). A mismatched k/v cache returns no GPU kernel and attention
#    falls back to CPU -> prompt processing collapses ~14x (measured 112 vs 1551
#    t/s at 256k). The default is already symmetric q8_0; this only fires if an
#    explicit per-side --kv-k/--kv-v disagree. Large head_dim (e.g. gemma4's 512)
#    is fine either way: it runs on the f16 mma kernel, which dequantizes a
#    quantized cache on read and stays on GPU.
if [ "$FORCE_F16" = 1 ]; then
    if { [ "$KVTYPE_K" != f16 ] || [ "$KVTYPE_V" != f16 ]; }; then
        echo ">> --fa off: forcing f16 KV cache (was k=$KVTYPE_K/v=$KVTYPE_V)"
    fi
    KVTYPE_K=f16
    KVTYPE_V=f16
elif [ "$FA_ON" = 1 ] && [ "$KVTYPE_K" != "$KVTYPE_V" ]; then
    echo ">> flash-attn needs a symmetric KV cache on this build -> using q8_0/q8_0 (was k=$KVTYPE_K/v=$KVTYPE_V; mismatched k/v falls back to CPU)"
    KVTYPE_K=q8_0
    KVTYPE_V=q8_0
fi

# ---- sampler defaults ------------------------------------------------------
# DRY penalizes repeated token *sequences*. It looked like safe loop insurance,
# but in agentic use it corrupts long verbatim literals: a file path or UUID has
# no sequence breakers, so retyping it from context gets penalized into typos
# (observed with Claude Code subagents). Off by default; --dry <n> re-enables
# for chat/creative use. Any client dry_multiplier still overrides.
SAMPLER_ARGS=()
if [ -n "$DRY" ] && [ "$DRY" != 0 ] && [ "$DRY" != 0.0 ]; then
    SAMPLER_ARGS=(--dry-multiplier "$DRY" --dry-base 1.75 --dry-allowed-length 2)
fi

# ---- free the GPU ---------------------------------------------------------
if command -v lms >/dev/null 2>&1; then
    echo ">> Unloading LM Studio models to free VRAM..."
    lms unload --all || true
    sleep 1
fi
echo ">> GPU before launch:"
gpu_status "$BACKEND"

# ---- smart expert-offload estimate (model + free-VRAM + context aware) ------
KVBITS="$(awk -v k="$(kv_bits "$KVTYPE_K")" -v v="$(kv_bits "$KVTYPE_V")" 'BEGIN{print (k+v)/2}')"

NCMOE_CAP=64 # upper bound for auto-retry; refined to layer count if known
MODE=moe     # "moe" (bump --n-cpu-moe up) or "dense" (bump -ngl down); set by estimator
NCMOE_PRESET="$NCMOE" # user/tune-pinned offload value ("" = auto). The estimator
# still runs with a preset so MODE (dense-vs-moe) and the layer cap resolve
# correctly — a preset used to leave dense models on the moe launch path.
case "$BACKEND" in
metal | cpu)
    # unified memory / no discrete VRAM: expert offload buys nothing by default
    # (a percentage preset from a shared model table means nothing here either)
    case "$NCMOE" in '' | *%) NCMOE=0 ;; esac
    ;;
*)
    FREE_MIB="$(free_vram_mib "$BACKEND")"
    # MTP keeps an extra draft context resident (~2 GB); shave it off the
    # free-VRAM figure so the offload estimate leaves headroom instead of
    # OOM-ing straight into the retry loop.
    FREE_MIB_NO_MTP="${FREE_MIB:-}"
    if [ -n "$MTP" ] && [ -n "${FREE_MIB:-}" ]; then
        FREE_MIB=$((FREE_MIB > 2048 ? FREE_MIB - 2048 : 0))
    fi
    est=""
    if [ "${MODEL_ARGS[0]}" = "-m" ] && [ -n "${FREE_MIB:-}" ] && command -v python3 >/dev/null 2>&1; then
        est="$(python3 "$SCRIPT_DIR/gguf-estimate.py" "${MODEL_ARGS[1]}" "$FREE_MIB" "$CONTEXT" "$PARALLEL" "$KVBITS" 2>/dev/null || true)"
        # KV auto-stepdown: with no explicit --kv, a leaner q4_0 cache beats a
        # near-lossless q8_0 one that pushes weights (or MTP) off the GPU —
        # gemma-4-12B on a 12GB 4070 @64k: q8_0 = 46/48 layers ≈ 74 t/s,
        # q4_0 = 48/48 + MTP ≈ 102 t/s. Runs before the MTP demotion below so
        # the draft head survives whenever a leaner cache makes room for it.
        est_rest="${est#* }"
        if [ -n "$KV_AUTO" ] && [ "$FORCE_F16" = 0 ] && [ "$KVTYPE_K" = "q8_0" ] &&
            [ -n "$est" ] && [ "${est%% *} ${est_rest%% *}" != "moe 0" ]; then
            est_q4="$(python3 "$SCRIPT_DIR/gguf-estimate.py" "${MODEL_ARGS[1]}" "$FREE_MIB" "$CONTEXT" "$PARALLEL" 4.5 2>/dev/null || true)"
            est_q4_rest="${est_q4#* }"
            KV_STEP=""
            # ONLY when q4_0 restores FULL offload. Trading KV precision for a
            # few extra layers on a still-partial config is a bad deal: it cost
            # little speed but sent gemma-4-26B-A4B (QAT-Q4_0 weights) into
            # degenerate repetition loops. Quality collapse generates fast —
            # the probe can't catch it, so step down only for the big win.
            [ -n "$est_q4" ] && [ "${est_q4%% *} ${est_q4_rest%% *}" = "moe 0" ] && KV_STEP=1
            if [ -n "$KV_STEP" ]; then
                echo ">> KV cache: auto-stepping q8_0 -> q4_0 — restores FULL GPU offload at ctx=$CONTEXT (--kv q8_0 to force)"
                KVTYPE_K=q4_0
                KVTYPE_V=q4_0
                KVBITS=4.5
                est="$est_q4"
                est_rest="$est_q4_rest"
            fi
        fi
        # Auto-MTP only pays for itself while the model sits fully on GPU:
        # its ~2GB draft context otherwise displaces layers, and every layer
        # pushed to CPU costs far more decode speed than MTP recovers
        # (gemma-4-12B @256k: 23/48 layers, ~8 t/s). If the reserve breaks
        # full offload, drop the head and re-estimate with the budget back.
        if [ -n "$MTP" ] && [ "$MTP_MODE" = auto ] && [ -n "$est" ] &&
            [ "${est%% *} ${est_rest%% *}" != "moe 0" ]; then
            echo ">> MTP: auto-disabled — model doesn't fully fit on GPU at ctx=$CONTEXT, reclaiming ~2GB for layer offload (--mtp on to force)"
            MTP=""
            MTP_DRAFT=""
            SPEC_ARGS=()
            FREE_MIB="$FREE_MIB_NO_MTP"
            est="$(python3 "$SCRIPT_DIR/gguf-estimate.py" "${MODEL_ARGS[1]}" "$FREE_MIB" "$CONTEXT" "$PARALLEL" "$KVBITS" 2>/dev/null || true)"
        fi
    fi
    if [ -n "$est" ]; then
        MODE="${est%% *}" # "<mode> <value> <layers>"
        rest="${est#* }"
        NCMOE="${rest%% *}"
        NCMOE_CAP="${rest##* }"
        if [ -n "$NCMOE_PRESET" ]; then
            # offload pinned by the user or a tune record; estimator ran only
            # to resolve MODE and the cap
            EST_VAL="$NCMOE"
            NCMOE="$(resolve_ncmoe_pct "$NCMOE_PRESET" "$NCMOE_CAP")"
            case "$NCMOE_PRESET" in
            *%) echo ">> preset offload: $([ "$MODE" = "dense" ] && echo "-ngl" || echo "n-cpu-moe")=$NCMOE ($NCMOE_PRESET of $NCMOE_CAP layers; estimator suggested $EST_VAL)" ;;
            *) echo ">> preset offload: $([ "$MODE" = "dense" ] && echo "-ngl" || echo "n-cpu-moe")=$NCMOE (estimator suggested $EST_VAL of $NCMOE_CAP layers)" ;;
            esac
        elif [ "$MODE" = "dense" ]; then
            echo ">> dense model: offloading via -ngl=$NCMOE (of $NCMOE_CAP layers) for ${FREE_MIB}MiB free, ctx=$CONTEXT"
        else
            echo ">> estimated n-cpu-moe=$NCMOE (of $NCMOE_CAP layers) for ${FREE_MIB}MiB free, ctx=$CONTEXT"
        fi
        # loud speed warning whenever the launch config leaves weights on the
        # CPU, plus the largest context that would still fit fully on GPU
        PARTIAL=""
        [ "$MODE" = "dense" ] && [ "$NCMOE" -lt "$NCMOE_CAP" ] && PARTIAL=1
        [ "$MODE" = "moe" ] && [ "$NCMOE" -gt 0 ] && PARTIAL=1
        if [ -n "$PARTIAL" ]; then
            if [ -n "${TUNED_APPLIED:-}" ]; then
                probe_say ">> note: partial offload ($NCMOE of $NCMOE_CAP) is the measured-fastest config for this ctx (via '$0 tune')"
            else
                CTX_TIP="$(max_full_fit_ctx "${MODEL_ARGS[1]}" "$FREE_MIB" "$PARALLEL" "$KVBITS" "$CONTEXT")"
                warn_partial_offload "$CTX_TIP"
            fi
        fi
    elif [ -n "$NCMOE_PRESET" ]; then
        case "$NCMOE_PRESET" in
        *%) echo ">> layer count unknown (no local GGUF header): resolving $NCMOE_PRESET against $NCMOE_CAP layers" ;;
        esac
        NCMOE="$(resolve_ncmoe_pct "$NCMOE_PRESET" "$NCMOE_CAP")"
    else # fallback: context buckets
        if [ "$CONTEXT" -le 16384 ]; then
            NCMOE=28
        elif [ "$CONTEXT" -le 65536 ]; then
            NCMOE=32
        else
            NCMOE=40
        fi
        echo ">> estimate unavailable; using fallback n-cpu-moe=$NCMOE"
    fi
    ;;
esac

# mmap is the right default on unified memory (Metal); --no-mmap elsewhere so
# CPU-side expert weights land in real RAM instead of thrashing page cache.
MMAP_ARGS=(--no-mmap)
[ "$BACKEND" = "metal" ] && MMAP_ARGS=()

# ---- chat template override --------------------------------------------------
# Some GGUFs ship a Jinja chat template that llama.cpp's engine can't render.
# Gemma 4's tool-use template upper-cases a non-string (union) parameter type
# with `map('upper')` — a filter-mapping the engine doesn't implement, throwing
# at common/jinja/value.cpp "map: filter-mapping not implemented". Requests
# carrying such a tool 500 and break agent clients (pi, opencode).
#
# Current llama.cpp renders most of this template with a specialized native
# parser, which HIDES the bug for the shapes people test first: a top-level
# `"type": ["integer","null"]` renders fine. It is NOT a full fix — a union
# nested inside an array's items still reaches the Jinja path and 500s:
#     {"type": "array", "items": {"type": ["string", "null"]}}
# That shape is common in real agent tool schemas, so keep auto-applying the
# bundled fix (it rewrites just that one line as an explicit loop) unless
# IGNORE_TEMPLATE=1. Re-test with the array-items union above before removing.
TEMPLATE_ARGS=()
if [ -n "$TEMPLATE" ]; then
    if [ ! -f "$TEMPLATE" ]; then
        echo "!! --chat-template file not found: $TEMPLATE" >&2
        exit 1
    fi
    TEMPLATE_ARGS=(--chat-template-file "$TEMPLATE")
    echo ">> chat template: $TEMPLATE"
elif [ -z "${IGNORE_TEMPLATE:-}" ]; then
    alias_lc="$(printf '%s' "$ALIAS" | tr '[:upper:]' '[:lower:]')"
    case "$alias_lc" in
    *gemma-4* | *gemma4*)
        if [ -f "$SCRIPT_DIR/templates/gemma-4-fixed.jinja" ]; then
            TEMPLATE_ARGS=(--chat-template-file "$SCRIPT_DIR/templates/gemma-4-fixed.jinja")
            echo ">> chat template: auto-applied Gemma-4 map('upper') fix (IGNORE_TEMPLATE=1 to disable, --chat-template to override)"
        fi
        ;;
    esac
fi

if [ -n "$MTP" ]; then MTP_DESC="draft-mtp n-max=$MTP_NMAX"; else MTP_DESC="none"; fi
echo ">> model=$MODEL"
if [ "$KVTYPE_K" = "$KVTYPE_V" ]; then KV_DESC="$KVTYPE_K"; else KV_DESC="k=$KVTYPE_K/v=$KVTYPE_V"; fi
echo ">> context=$CONTEXT  threads=$THREADS  kv=$KV_DESC  fa=$([ "$FA_ON" = 1 ] && echo on || echo off)  dry=${DRY:-off}  parallel=$PARALLEL  draft=${DRAFT:-none}  mtp=$MTP_DESC"
echo ">> serving http://${HOST}:${PORT}/v1  (Ctrl-C to stop)"
cd "$LLAMA_DIR"

# Speculative decoding (MTP/draft) and embeddings need SEPARATE model contexts —
# one causal+draft, one pooled — and cannot share a single in-process model
# (GGML_ASSERT "missing result_norm/result_embd tensor"). When both are wanted,
# switch to llama.cpp router mode: each model runs as its own child process with
# its own params (MTP only on the chat model, embeddings only on the embedding
# model), all behind one endpoint. Requires a local-file chat model and an
# embedding model; otherwise fall back to MTP-only with embeddings off.
USE_ROUTER=""
EMBED_HIT=""
if [ -n "$ALLMODELS" ] && { [ -n "$MTP" ] || [ -n "$DRAFT" ]; }; then
    if [ "${MODEL_ARGS[0]}" = "-m" ] && { [ -z "$DRAFT" ] || [ -f "$DRAFT" ]; }; then
        EMBED_HIT="$(resolve_embed_model)"
    fi
    if [ -n "$EMBED_HIT" ]; then
        USE_ROUTER=1
        ALLMODELS="" # the router serves embeddings itself; skip single-process embeddings flags
        echo ">> embeddings + speculative: router mode (chat=$ALIAS, embeddings=$(basename "$EMBED_HIT"))"
    else
        echo ">> note: no embedding model found (set EMBED_MODEL=) — disabling embeddings while speculative decoding is active"
        ALLMODELS=""
    fi
fi

if [ -n "$ALLMODELS" ]; then
    ALLMODELS_EXTRA=(--models-dir "$MODELS_DIR" --models-max "$MODELS_MAX" --pooling cls --embeddings)
fi

LLAMA_BIN="${LLAMA_BIN:-./build/bin/llama-server}"
if [ ! -x "$LLAMA_BIN" ]; then
    echo "!! $LLAMA_BIN not found. Build llama.cpp for backend '$BACKEND' (see header: $0 -h)" >&2
    exit 1
fi

# Newer llama.cpp builds split the server into shared libs (libllama-server-impl.so,
# libggml*.so, ...) next to the launcher, often without an $ORIGIN rpath — so the
# loader can't find them. Put that dir on LD_LIBRARY_PATH (absolute, survives the cd).
LLAMA_LIBDIR="$(cd "$(dirname "$LLAMA_BIN")" && pwd)"
if ls "$LLAMA_LIBDIR"/*.so >/dev/null 2>&1; then
    export LD_LIBRARY_PATH="$LLAMA_LIBDIR:${LD_LIBRARY_PATH:-}"
fi

# device OOM signatures across backends (CUDA / HIP / Vulkan / Metal)
OOM_RE='out of memory|failed to allocate|failed to create context|cudaMalloc failed|hipMalloc failed|hipErrorOutOfMemory|VK_ERROR_OUT_OF_DEVICE_MEMORY|ErrorOutOfDeviceMemory|Insufficient Memory|kIOGPUCommandBufferCallbackErrorOutOfMemory'

# ---- router mode: one endpoint, a child process per model -------------------
# Generate a preset INI (chat model with MTP/draft + a small embedding model),
# launch llama.cpp's router so each model loads as its own child with its own
# params, then serve until stopped. No expert-offload auto-retry here: each child
# manages its own VRAM, and n-cpu-moe was already sized for the chat model.
if [ -n "$USE_ROUTER" ]; then
    EMBED_ALIAS="$(basename "$EMBED_HIT")"
    EMBED_ALIAS="${EMBED_ALIAS%.gguf}"
    TPL_FILE=""
    [ "${#TEMPLATE_ARGS[@]}" -ge 2 ] && TPL_FILE="${TEMPLATE_ARGS[1]}"
    INI="$(mktemp "${TMPDIR:-/tmp}/highllama-presets.XXXXXX.ini")"
    {
        printf '[%s]\n' "$ALIAS"
        printf 'model = %s\n' "${MODEL_ARGS[1]}"
        # Honor the estimator's offload decision (mirrors the non-router path):
        # dense models offload via -ngl (n-cpu-moe is a no-op there), MoE models
        # keep all layers on GPU and push experts to CPU via n-cpu-moe. Hardcoding
        # n-gpu-layers=99 for a dense model ignores the estimate and OOMs.
        if [ "$MODE" = "dense" ]; then
            printf 'n-gpu-layers = %s\n' "$NCMOE"
        else
            printf 'n-gpu-layers = 99\n'
            printf 'n-cpu-moe = %s\n' "$NCMOE"
        fi
        printf 'threads = %s\n' "$THREADS"
        printf 'flash-attn = %s\n' "$([ "$FA_ON" = 1 ] && echo on || echo off)"
        printf 'cache-type-k = %s\n' "$KVTYPE_K"
        printf 'cache-type-v = %s\n' "$KVTYPE_V"
        printf 'ctx-size = %s\n' "$CONTEXT"
        printf 'parallel = %s\n' "$PARALLEL"
        if [ "${#SAMPLER_ARGS[@]}" -gt 0 ]; then
            printf 'dry-multiplier = %s\n' "$DRY"
            printf 'dry-base = 1.75\n'
            printf 'dry-allowed-length = 2\n'
        fi
        [ "$BACKEND" != "metal" ] && printf 'no-mmap = true\n'
        printf 'jinja = true\n'
        [ -n "$TPL_FILE" ] && printf 'chat-template-file = %s\n' "$TPL_FILE"
        [ -n "$MMPROJ_HIT" ] && printf 'mmproj = %s\n' "$MMPROJ_HIT"
        if [ -n "$MTP" ]; then
            printf 'spec-type = draft-mtp\n'
            # empty when the MTP head is embedded in the main GGUF (no separate -md)
            [ -n "$MTP_DRAFT" ] && printf 'model-draft = %s\n' "$MTP_DRAFT"
            printf 'spec-draft-n-max = %s\n' "$MTP_NMAX"
            printf 'n-gpu-layers-draft = 99\n'
        elif [ -n "$DRAFT" ]; then
            printf 'model-draft = %s\n' "$DRAFT"
            printf 'spec-draft-n-max = 16\n'
            printf 'n-gpu-layers-draft = 99\n'
        fi
        printf 'load-on-startup = true\n'
        printf '\n[%s]\n' "$EMBED_ALIAS"
        printf 'model = %s\n' "$EMBED_HIT"
        printf 'embeddings = true\n'
        # Use the model's GGUF-native pooling by default — forcing cls on a
        # mean-trained model (e.g. embeddinggemma) yields near-degenerate vectors
        # that don't discriminate. Override only via EMBED_POOLING=.
        [ -n "${EMBED_POOLING:-}" ] && printf 'pooling = %s\n' "$EMBED_POOLING"
        printf 'ctx-size = %s\n' "${EMBED_CTX:-2048}"
        printf 'load-on-startup = true\n'
    } >"$INI"
    echo ">> router preset ($INI):"
    sed 's/^/     /' "$INI"
    echo ">> launching router (models-max=$MODELS_MAX) on http://${HOST}:${PORT}/v1 ..."
    RLOG="$(mktemp "${TMPDIR:-/tmp}/highllama-router.XXXXXX")"
    RSRV=""
    RTAIL=""
    cleanup_router() {
        [ -n "$RTAIL" ] && kill "$RTAIL" 2>/dev/null
        [ -n "$RSRV" ] && kill "$RSRV" 2>/dev/null
        rm -f "$RLOG" "$INI"
    }
    trap cleanup_router EXIT
    trap 'exit 130' INT TERM
    RCMD=(
        "$LLAMA_BIN" --models-preset "$INI" --models-max "$MODELS_MAX"
        --host "$HOST" --port "$PORT" ${EXTRA[@]+"${EXTRA[@]}"}
    )
    printf '>> llama-server (router):'; printf ' %q' "${RCMD[@]}"; printf '\n'
    echo ">> preset INI ($INI):"; sed 's/^/   /' "$INI"
    [ -n "${HL_CMDDUMP:-}" ] && { printf '%q ' "${RCMD[@]}"; printf '\n\n'; sed 's/^/# /' "$INI"; } >"$HL_CMDDUMP"
    "${RCMD[@]}" >"$RLOG" 2>&1 &
    RSRV=$!
    tail -f -n +1 "$RLOG" & # stream router + child logs live
    RTAIL=$!
    # ready when both children report in, or bail on OOM / a bad preset key
    ROUTER_READY=""
    while kill -0 "$RSRV" 2>/dev/null; do
        if [ "$(command grep -c 'cmd_child_to_router:ready' "$RLOG" 2>/dev/null || echo 0)" -ge 2 ]; then
            echo ">> router ready: chat + embeddings models loaded"
            ROUTER_READY=1
            break
        fi
        if command grep -qiE "$OOM_RE|not recognized in preset|GGML_ASSERT" "$RLOG"; then
            echo "!! router failed to start (see log above)" >&2
            exit 1
        fi
        sleep 0.5
    done
    [ -n "$ROUTER_READY" ] && run_probe_and_guard "$PORT" "$ALIAS"
    wait "$RSRV"
    exit $?
fi

# ---- launch with OOM auto-retry: bump expert-offload until it fits ----------
LOG="$(mktemp "${TMPDIR:-/tmp}/highllama.XXXXXX")"
SRV=""
TAILER=""
cleanup() {
    [ -n "$TAILER" ] && kill "$TAILER" 2>/dev/null
    [ -n "$SRV" ] && kill "$SRV" 2>/dev/null
    rm -f "$LOG"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

STEP=3
while :; do
    : >"$LOG"
    if [ "$MODE" = "dense" ]; then
        OFFLOAD_ARGS=(-ngl "$NCMOE")
        echo ">> launching with n-gpu-layers=$NCMOE (dense model) ..."
    else
        OFFLOAD_ARGS=(-ngl 99 --n-cpu-moe "$NCMOE")
        echo ">> launching with n-cpu-moe=$NCMOE ..."
    fi
    CMD=(
        "$LLAMA_BIN"
        "${MODEL_ARGS[@]}"
        --alias "$ALIAS"
        "${OFFLOAD_ARGS[@]}"
        -t "$THREADS"
        -fa "$FA_ON"
        -ctk "$KVTYPE_K" -ctv "$KVTYPE_V"
        -c "$CONTEXT"
        --parallel "$PARALLEL"
        ${SAMPLER_ARGS[@]+"${SAMPLER_ARGS[@]}"}
        ${MMAP_ARGS[@]+"${MMAP_ARGS[@]}"}
        --jinja
        ${TEMPLATE_ARGS[@]+"${TEMPLATE_ARGS[@]}"}
        ${SPEC_ARGS[@]+"${SPEC_ARGS[@]}"}
        ${MMPROJ_ARGS[@]+"${MMPROJ_ARGS[@]}"}
        --host "$HOST" --port "$PORT"
        ${ALLMODELS_EXTRA[@]+"${ALLMODELS_EXTRA[@]}"}
        ${EXTRA[@]+"${EXTRA[@]}"}
    )
    printf '>> llama-server:'; printf ' %q' "${CMD[@]}"; printf '\n'
    [ -n "${HL_CMDDUMP:-}" ] && { printf '%q ' "${CMD[@]}"; printf '\n'; } >"$HL_CMDDUMP"
    "${CMD[@]}" >"$LOG" 2>&1 &
    SRV=$!
    tail -f -n +1 "$LOG" & # stream server logs live (killed in cleanup; no GNU --pid)
    TAILER=$!

    # watch for readiness vs. out-of-memory while the server is starting
    outcome=""
    while kill -0 "$SRV" 2>/dev/null; do
        if command grep -q "server is listening" "$LOG"; then
            outcome="ok"
            break
        fi
        if command grep -qiE "$OOM_RE" "$LOG"; then
            outcome="oom"
            break
        fi
        sleep 0.5
    done

    if [ "$outcome" = "ok" ]; then
        run_probe_and_guard "$PORT" "$ALIAS"
        wait "$SRV"
        exit $? # serve until stopped
    fi

    # not ok: stop this attempt, then either retry (OOM) or give up
    kill "$SRV" 2>/dev/null
    wait "$SRV" 2>/dev/null || true
    kill "$TAILER" 2>/dev/null
    TAILER=""
    if [ "$outcome" != "oom" ]; then
        echo "!! server exited without becoming ready (not an OOM). Last log lines:" >&2
        tail -n 15 "$LOG" >&2
        exit 1
    fi
    if [ "$MODE" = "dense" ]; then
        NCMOE=$((NCMOE - STEP))
        if [ "$NCMOE" -lt 0 ]; then
            echo "!! still OOM with all layers on CPU (-ngl 0). Try smaller -c (context) or a smaller model." >&2
            exit 1
        fi
        echo ">> OOM — retrying with fewer GPU layers (-ngl $NCMOE)"
    else
        NCMOE=$((NCMOE + STEP))
        if [ "$NCMOE" -gt "$NCMOE_CAP" ]; then
            echo "!! still OOM at max offload (n-cpu-moe=$NCMOE_CAP). Try smaller -c (context) or a smaller model." >&2
            exit 1
        fi
        echo ">> OOM — retrying with more CPU offload (n-cpu-moe=$NCMOE)"
    fi
done
